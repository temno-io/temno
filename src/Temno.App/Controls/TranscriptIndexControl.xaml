<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Temno.App.Controls.TranscriptIndexControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Temno.App.Controls.Shared"
    AutomationProperties.Name="Transcript Index">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Background="{StaticResource AppTheme.Background.Raised}"
            BorderBrush="{StaticResource AppTheme.Border.Primary}"
            BorderThickness="0,0,0,1"
            Padding="{StaticResource AppTheme.Padding.Md}">
            <StackPanel Spacing="{StaticResource AppTheme.Spacing.Sm}">
                <Grid ColumnSpacing="{StaticResource AppTheme.Spacing.SmMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Xs}">
                        <ToggleButton
                            x:Name="TranscriptModeBtn"
                            Padding="{StaticResource AppTheme.Padding.Control}"
                            AutomationProperties.Name="Transcript"
                            Click="Mode_Click"
                            Content="Transcript"
                            FontSize="{StaticResource AppTheme.FontSize.Sm}"
                            IsChecked="True"
                            Tag="Transcript"
                            ToolTipService.ToolTip="Timestamped transcript — click a word to seek, select a range to cut" />
                        <ToggleButton
                            x:Name="MarkersModeBtn"
                            Padding="{StaticResource AppTheme.Padding.Control}"
                            AutomationProperties.Name="Markers"
                            Click="Mode_Click"
                            Content="Markers"
                            FontSize="{StaticResource AppTheme.FontSize.Sm}"
                            Tag="Markers"
                            ToolTipService.ToolTip="Timeline markers — click to seek" />
                    </StackPanel>
                    <Button
                        x:Name="CutBtn"
                        Grid.Column="1"
                        Padding="{StaticResource AppTheme.Padding.Control}"
                        AutomationProperties.Name="Cut selected words"
                        Click="Cut_Click"
                        Content="Cut"
                        FontSize="{StaticResource AppTheme.FontSize.Sm}"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Remove the selected words (ripple, one undo step)" />
                </Grid>
                <TextBox
                    x:Name="SearchBox"
                    AutomationProperties.Name="Search transcript"
                    FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                    KeyDown="SearchBox_KeyDown"
                    PlaceholderText="Search transcript"
                    TextChanged="SearchBox_TextChanged"
                    ToolTipService.ToolTip="Filter sentences. Enter jumps to the next match." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer
                x:Name="TranscriptScroll"
                Padding="{StaticResource AppTheme.Padding.Md}"
                VerticalScrollBarVisibility="Auto">
                <StackPanel
                    x:Name="TranscriptHost"
                    Spacing="{StaticResource AppTheme.Spacing.Md}" />
            </ScrollViewer>

            <ScrollViewer
                x:Name="MarkersScroll"
                Padding="{StaticResource AppTheme.Padding.Md}"
                Visibility="Collapsed"
                VerticalScrollBarVisibility="Auto">
                <StackPanel
                    x:Name="MarkersHost"
                    Spacing="{StaticResource AppTheme.Spacing.Sm}" />
            </ScrollViewer>

            <Grid
                x:Name="EmptyState"
                Padding="{StaticResource AppTheme.Padding.Lg}"
                Visibility="Collapsed">
                <StackPanel
                    MaxWidth="240"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource AppTheme.Spacing.MdLg}">
                    <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Display}" Height="{StaticResource AppTheme.IconSize.Display}" HorizontalAlignment="Center" Fill="{StaticResource AppTheme.Text.Muted}" Icon="{x:Bind shared:Icons.DocumentText}" />
                    <TextBlock
                        x:Name="EmptyTitle"
                        FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppTheme.Text.Secondary}"
                        Text="No transcript cached yet"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="EmptyBody"
                        FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                        Foreground="{StaticResource AppTheme.Text.Tertiary}"
                        Text="Generate one from the Captions tab. Index reads that transcript; it does not transcribe on its own."
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <Button
                        x:Name="EmptyActionBtn"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Open Captions to generate transcript"
                        Click="EmptyAction_Click"
                        Content="Open Captions"
                        FontSize="{StaticResource AppTheme.FontSize.Sm}"
                        ToolTipService.ToolTip="Switch to Captions and generate a transcript" />
                </StackPanel>
            </Grid>

            <InfoBar
                x:Name="ErrorBar"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                IsClosable="True"
                IsOpen="False"
                Severity="Error"
                Title="Transcript Index" />

            <Grid
                x:Name="BusyOverlay"
                Background="{StaticResource AppTheme.Background.OverlayScrim}"
                Visibility="Collapsed"
                AutomationProperties.Name="Loading transcript">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource AppTheme.Spacing.Md}"
                    AutomationProperties.Name="Loading transcript">
                    <ProgressRing
                        x:Name="BusyRing"
                        Width="32"
                        Height="32"
                        IsActive="False" />
                    <TextBlock
                        FontSize="{StaticResource AppTheme.FontSize.Md}"
                        Foreground="{StaticResource AppTheme.Text.Primary}"
                        Text="Loading transcript…" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Temno.App.Controls.AccountControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Temno.App.Controls.Shared">

    <UserControl.Resources>
        <!--  WP-446: Google's pre-approved "Sign in with Google" button (signin-assets.zip, Light pill, the 4x PNG),
              shown whole at Google's own 180 x 40. Google's branding rules fix its size, colours and G, so these are
              Google's numbers and not Temno tokens, and nothing here restyles the image: the template adds only
              Google's state layer on hover and press, the focus ring, and the 38% Google gives a disabled button.
              Light on a dark surface, as on the sign-in page (WP-353).  -->
        <x:Double x:Key="GoogleSignInButton.Width">180</x:Double>
        <x:Double x:Key="GoogleSignInButton.Height">40</x:Double>
        <CornerRadius x:Key="GoogleSignInButton.CornerRadius">20</CornerRadius>
        <Thickness x:Key="GoogleSignInButton.FocusMargin">-3</Thickness>
        <SolidColorBrush x:Key="GoogleSignInButton.StateLayer" Color="#303030" />
        <Style x:Key="GoogleSignInButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="{StaticResource GoogleSignInButton.Width}" />
            <Setter Property="Height" Value="{StaticResource GoogleSignInButton.Height}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{StaticResource GoogleSignInButton.CornerRadius}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="{StaticResource GoogleSignInButton.FocusMargin}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="StateLayer.Opacity" Value="0.08" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="StateLayer.Opacity" Value="0.12" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Face.Opacity" Value="0.38" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Image
                                x:Name="Face"
                                Width="{StaticResource GoogleSignInButton.Width}"
                                Height="{StaticResource GoogleSignInButton.Height}"
                                Stretch="Fill">
                                <Image.Source>
                                    <BitmapImage
                                        DecodePixelHeight="40"
                                        DecodePixelType="Logical"
                                        DecodePixelWidth="180"
                                        UriSource="ms-appx:///Assets/GoogleSignInLightPill.png" />
                                </Image.Source>
                            </Image>
                            <Border
                                x:Name="StateLayer"
                                Background="{StaticResource GoogleSignInButton.StateLayer}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel Spacing="{StaticResource AppTheme.Spacing.Md}">
            <TextBlock
                x:Name="HeadingText"
                FontSize="{StaticResource AppTheme.FontSize.Xl}"
                FontWeight="SemiBold"
                Foreground="{StaticResource AppTheme.Text.Primary}"
                Text="Account" />
            <TextBlock
                FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                Foreground="{StaticResource AppTheme.Text.Tertiary}"
                Text="The editor stays usable signed out. Hosted credits are optional."
                TextWrapping="WrapWholeWords" />
            <TextBlock
                x:Name="EnvironmentText"
                FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                Foreground="{StaticResource AppTheme.Text.Tertiary}"
                TextWrapping="WrapWholeWords"
                Visibility="Collapsed" />

            <StackPanel x:Name="SignedOutPane" Spacing="{StaticResource AppTheme.Spacing.Md}">
                <TextBlock
                    x:Name="SignedOutHint"
                    FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                    Foreground="{StaticResource AppTheme.Text.Secondary}"
                    TextWrapping="WrapWholeWords" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Sm}">
                    <Button
                        x:Name="SignInButton"
                        Style="{StaticResource GoogleSignInButtonStyle}"
                        AutomationProperties.Name="Sign in with Google"
                        Click="SignIn_Click"
                        ToolTipService.ToolTip="Continue securely in your browser" />
                    <Button
                        x:Name="CancelSignInButton"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Cancel sign-in"
                        Click="CancelSignIn_Click"
                        Content="Cancel"
                        FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                        ToolTipService.ToolTip="Stop waiting for the browser callback"
                        Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="SignedInPane" Spacing="{StaticResource AppTheme.Spacing.Md}" Visibility="Collapsed">
                <Grid ColumnSpacing="{StaticResource AppTheme.Spacing.MdLg}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <shared:AccountAvatar
                        x:Name="ProfileAvatar"
                        Width="{StaticResource AppTheme.IconSize.Hero}"
                        Height="{StaticResource AppTheme.IconSize.Hero}"
                        VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                        <TextBlock
                            x:Name="DisplayNameText"
                            FontSize="{StaticResource AppTheme.FontSize.MdLg}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AppTheme.Text.Primary}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            x:Name="IdentityText"
                            FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                            Foreground="{StaticResource AppTheme.Text.Secondary}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>
                <TextBlock
                    x:Name="BalanceText"
                    FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                    Foreground="{StaticResource AppTheme.Text.Secondary}"
                    TextWrapping="WrapWholeWords" />
                <!-- WP-354: what this sign-in did about the signup credits, and why not. -->
                <TextBlock
                    x:Name="SignupGrantText"
                    FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                    Foreground="{StaticResource AppTheme.Text.Secondary}"
                    TextWrapping="WrapWholeWords"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="PlanText"
                    FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                    Foreground="{StaticResource AppTheme.Text.Secondary}"
                    TextWrapping="WrapWholeWords" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Sm}">
                    <Button
                        x:Name="ChoosePlanButton"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Choose a plan"
                        Click="ChoosePlan_Click"
                        Content="Choose a plan"
                        FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                        ToolTipService.ToolTip="See plans and subscribe in the browser" />
                    <Button
                        x:Name="ManageBillingButton"
                        AutomationProperties.Name="Manage billing"
                        Click="ManageBilling_Click"
                        Content="Manage billing"
                        FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                        ToolTipService.ToolTip="Open billing to change payment or cancel" />
                    <Button
                        x:Name="RetryPlansButton"
                        AutomationProperties.Name="Try loading plans again"
                        Click="RetryPlans_Click"
                        Content="Try again"
                        FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                        ToolTipService.ToolTip="Load plans again"
                        Visibility="Collapsed" />
                </StackPanel>
                <StackPanel
                    x:Name="TopUpPane"
                    Spacing="{StaticResource AppTheme.Spacing.Xs}"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="TopUpText"
                        FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                        Foreground="{StaticResource AppTheme.Text.Tertiary}"
                        TextWrapping="WrapWholeWords" />
                    <StackPanel
                        x:Name="TopUpBuyRow"
                        Orientation="Horizontal"
                        Spacing="{StaticResource AppTheme.Spacing.SmMd}"
                        Visibility="Collapsed">
                        <ComboBox
                            x:Name="TopUpAmountBox"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Credit amount"
                            FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                            SelectionChanged="TopUpAmount_SelectionChanged"
                            ToolTipService.ToolTip="How many credits to buy, in steps of one pack" />
                        <Button
                            x:Name="BuyCreditsButton"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Buy credits"
                            Click="BuyCredits_Click"
                            Content="Buy credits"
                            FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                            ToolTipService.ToolTip="Open Stripe checkout for the chosen credits" />
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    x:Name="BillingNotice"
                    FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                    Foreground="{StaticResource AppTheme.Text.Tertiary}"
                    TextWrapping="WrapWholeWords"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="PlansEmpty"
                    FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                    Foreground="{StaticResource AppTheme.Text.Tertiary}"
                    Text="No plans are available."
                    TextWrapping="WrapWholeWords"
                    Visibility="Collapsed" />
                <StackPanel
                    x:Name="PlanList"
                    Spacing="{StaticResource AppTheme.Spacing.Sm}"
                    Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Sm}">
                    <Button
                        x:Name="RefreshButton"
                        AutomationProperties.Name="Refresh credit balance"
                        Click="Refresh_Click"
                        Content="Refresh balance"
                        FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                        ToolTipService.ToolTip="Read the hosted credit balance" />
                    <Button
                        x:Name="SignOutButton"
                        AutomationProperties.Name="Sign out"
                        Click="SignOut_Click"
                        Content="Sign out"
                        FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                        ToolTipService.ToolTip="Clear the local session" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                x:Name="StatusText"
                FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                Foreground="{StaticResource AppTheme.Text.Tertiary}"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Grid
            x:Name="BusyOverlay"
            Background="{StaticResource AppTheme.Background.OverlayScrim}"
            Visibility="Collapsed"
            AutomationProperties.Name="Account request in progress">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{StaticResource AppTheme.Spacing.Md}">
                <ProgressRing
                    x:Name="BusyRing"
                    Width="32"
                    Height="32"
                    IsActive="False" />
                <TextBlock
                    x:Name="BusyLabel"
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource AppTheme.FontSize.Md}"
                    Foreground="{StaticResource AppTheme.Text.Primary}"
                    Text="Waiting…" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

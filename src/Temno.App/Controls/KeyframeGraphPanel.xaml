<UserControl
    x:Class="Temno.App.Controls.KeyframeGraphPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="{StaticResource AppTheme.Spacing.Sm}">
        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AppTheme.Text.Primary}" Text="Keyframe graph" />
        <ComboBox
            x:Name="ChannelBox"
            Header="Channel"
            HorizontalAlignment="Stretch"
            SelectionChanged="ChannelBox_SelectionChanged">
            <ComboBoxItem Content="Opacity" Tag="opacity" IsSelected="True" />
            <ComboBoxItem Content="Volume (dB)" Tag="volume" />
            <ComboBoxItem Content="Rotation °" Tag="rotation" />
            <ComboBoxItem Content="Scale X" Tag="scale.a" />
            <ComboBoxItem Content="Scale Y" Tag="scale.b" />
            <ComboBoxItem Content="Position X" Tag="position.a" />
            <ComboBoxItem Content="Position Y" Tag="position.b" />
            <ComboBoxItem Content="Crop Left" Tag="crop.left" />
            <ComboBoxItem Content="Crop Top" Tag="crop.top" />
            <ComboBoxItem Content="Crop Right" Tag="crop.right" />
            <ComboBoxItem Content="Crop Bottom" Tag="crop.bottom" />
        </ComboBox>
        <Border
            Height="140"
            Background="{StaticResource AppTheme.Background.Surface}"
            BorderBrush="{StaticResource AppTheme.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="4">
            <Canvas
                x:Name="GraphCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                SizeChanged="GraphCanvas_SizeChanged"
                PointerPressed="Graph_PointerPressed"
                PointerMoved="Graph_PointerMoved"
                PointerReleased="Graph_PointerReleased"
                PointerCaptureLost="Graph_PointerCaptureLost"
                DoubleTapped="Graph_DoubleTapped" />
        </Border>
        <Grid RowSpacing="{StaticResource AppTheme.Spacing.Sm}" ColumnSpacing="{StaticResource AppTheme.Spacing.Sm}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="InterpBox" Grid.ColumnSpan="2" Header="Interpolation" HorizontalAlignment="Stretch" SelectionChanged="InterpBox_SelectionChanged">
                <ComboBoxItem Content="Smooth" Tag="smooth" IsSelected="True" />
                <ComboBoxItem Content="Linear" Tag="linear" />
                <ComboBoxItem Content="Hold" Tag="hold" />
            </ComboBox>
            <Button x:Name="AddAtPlayheadBtn" Grid.Row="1" Content="Add at playhead" Click="AddAtPlayhead_Click" HorizontalAlignment="Stretch" />
            <Button x:Name="DeleteKeyBtn" Grid.Row="1" Grid.Column="1" Content="Delete" Click="DeleteSelected_Click" HorizontalAlignment="Stretch" />
        </Grid>
        <TextBlock
            x:Name="StatusLabel"
            FontSize="{StaticResource AppTheme.FontSize.Xs}"
            Foreground="{StaticResource AppTheme.Text.Tertiary}"
            Text="Drag keys on value×time. Double-tap empty to add. Smooth/linear/hold per key."
            TextWrapping="WrapWholeWords" />
    </StackPanel>
</UserControl>

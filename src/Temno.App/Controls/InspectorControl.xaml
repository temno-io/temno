                                        </shared:EditorRow.RowContent>
                                    </shared:EditorRow>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                                        <Button x:Name="VolumeKfPrevBtn" MinWidth="{StaticResource AppTheme.ComponentSize.CompactButtonHeight}" MinHeight="{StaticResource AppTheme.ComponentSize.KeyframeButtonSize}" Padding="{StaticResource AppTheme.Padding.Xxs}" Click="VolumeKfPrev_Click" AutomationProperties.Name="Previous volume keyframe" ToolTipService.ToolTip="Previous volume keyframe" ><shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{x:Bind VolumeKfPrevBtn.Foreground, Mode=OneWay}" Icon="{x:Bind shared:Icons.ArrowPrevious}" /></Button>
                                        <Button x:Name="VolumeKfStampBtn" AllowFocusOnInteraction="False" MinWidth="{StaticResource AppTheme.ComponentSize.CompactButtonHeight}" MinHeight="{StaticResource AppTheme.ComponentSize.KeyframeButtonSize}" Padding="{StaticResource AppTheme.Padding.Xxs}" Click="VolumeKfStamp_Click" AutomationProperties.Name="Stamp volume keyframe at playhead" ToolTipService.ToolTip="Stamp / remove volume keyframe at playhead" ><shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{x:Bind VolumeKfStampBtn.Foreground, Mode=OneWay}" Icon="{x:Bind shared:Icons.Diamond}" /></Button>
                                        <Button x:Name="VolumeKfNextBtn" MinWidth="{StaticResource AppTheme.ComponentSize.CompactButtonHeight}" MinHeight="{StaticResource AppTheme.ComponentSize.KeyframeButtonSize}" Padding="{StaticResource AppTheme.Padding.Xxs}" Click="VolumeKfNext_Click" AutomationProperties.Name="Next volume keyframe" ToolTipService.ToolTip="Next volume keyframe" ><shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{x:Bind VolumeKfNextBtn.Foreground, Mode=OneWay}" Icon="{x:Bind shared:Icons.ArrowNext}" /></Button>
                                        <TextBlock x:Name="VolumeKfStatus" VerticalAlignment="Center" FontSize="{StaticResource AppTheme.FontSize.Xs}" Foreground="{StaticResource AppTheme.Text.Tertiary}" Text="" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock x:Name="VolumeLinearLabel" FontSize="{StaticResource AppTheme.FontSize.Xs}" Foreground="{StaticResource AppTheme.Text.Tertiary}" Text="Linear: 1.00" />
                                    <shared:EditorRow x:Name="FadeInRow" Label="Fade in">
                                        <shared:EditorRow.RowContent>
                                            <shared:UnitNumberField x:Name="FadeInBox" />
                                        </shared:EditorRow.RowContent>
                                    </shared:EditorRow>
                                    <shared:EditorRow x:Name="FadeOutRow" Label="Fade out">
                                        <shared:EditorRow.RowContent>
                                            <shared:UnitNumberField x:Name="FadeOutBox" />
                                        </shared:EditorRow.RowContent>
                                    </shared:EditorRow>
                                    <shared:EditorRow x:Name="DenoiseRow" Label="Denoise">
                                        <shared:EditorRow.RowContent>
                                            <ToggleSwitch x:Name="DenoiseSwitch" OffContent="Off" OnContent="On" Toggled="Denoise_Toggled" />
                                        </shared:EditorRow.RowContent>
                                    </shared:EditorRow>
                                    <TextBlock
                                        FontSize="{StaticResource AppTheme.FontSize.Xs}"
                                        Foreground="{StaticResource AppTheme.Text.Tertiary}"
                                        Text="Reduces noise in playback and export."
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </shared:SectionHeader.SectionContent>
                        </shared:SectionHeader>
                    </StackPanel>

                    <!-- CONTENT tab (text) -->
                    <StackPanel x:Name="TextTabPane" Spacing="{StaticResource AppTheme.Spacing.Sm}" Visibility="Collapsed">
                        <shared:SectionHeader Title="Text" SectionId="inspector.content.text">
                            <shared:SectionHeader.SectionContent>
                                <StackPanel Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                                    <shared:EditorRow x:Name="TextContentRow" Label="Content">
                                        <shared:EditorRow.RowContent>
                                            <TextBox
                                                x:Name="TextContentBox"
                                                AcceptsReturn="True"
                                                MinHeight="72"
                                                TextWrapping="Wrap"
                                                LostFocus="TextFields_LostFocus" />
                                        </shared:EditorRow.RowContent>
                                    </shared:EditorRow>
                                    <!-- WP-201: the TextStyle rows live in Shared/TextStyleRows.cs,
                                         used here and in the Captions Style section. -->
                                    <shared:TextStyleRows x:Name="TextStyleRows" />
                                </StackPanel>
                            </shared:SectionHeader.SectionContent>
                        </shared:SectionHeader>

                    </StackPanel>
                    <StackPanel x:Name="TextAnimationTabPane" Spacing="{StaticResource AppTheme.Spacing.Sm}" Visibility="Collapsed">
                        <shared:SectionHeader Title="Animate" SectionId="inspector.content.animate">
                            <shared:SectionHeader.SectionContent>
                                <StackPanel Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                                    <shared:EditorRow x:Name="TextAnimationRow" Label="Preset">
                                        <shared:EditorRow.RowContent>
                                            <ComboBox x:Name="TextAnimationBox" HorizontalAlignment="Stretch" PlaceholderText="—" SelectionChanged="TextAnimation_SelectionChanged" AutomationProperties.Name="Text animation">
                                                <ComboBoxItem Content="None" Tag="off" IsSelected="True" />
                                                <ComboBoxItem Content="Fade In" Tag="fadeIn" />
                                                <ComboBoxItem Content="Pop In" Tag="popIn" />
                                                <ComboBoxItem Content="Slide Up" Tag="slideUp" />
                                                <ComboBoxItem Content="Typewriter" Tag="typewriter" />
                                                <ComboBoxItem Content="Word Reveal" Tag="wordReveal" />
                                                <ComboBoxItem Content="Word Slide" Tag="wordSlide" />
                                                <ComboBoxItem Content="Word Pop" Tag="wordPop" />
                                                <ComboBoxItem Content="Word Cycle" Tag="wordCycle" />
                                                <ComboBoxItem Content="Highlight Pop" Tag="highlightPop" />
                                                <ComboBoxItem Content="Highlight Block" Tag="highlightBlock" />
                                            </ComboBox>
                                        </shared:EditorRow.RowContent>
                                    </shared:EditorRow>
                                    <shared:EditorRow x:Name="TextAnimPerWordRow" Label="Per-word">
                                        <shared:EditorRow.RowContent>
                                            <shared:UnitNumberField x:Name="TextAnimPerWordBox" />
                                        </shared:EditorRow.RowContent>
                                    </shared:EditorRow>
                                    <TextBlock
                                        FontSize="{StaticResource AppTheme.FontSize.Xs}"
                                        Foreground="{StaticResource AppTheme.Text.Tertiary}"
                                        Text="Animation applies in preview and export. Windows uses DirectWrite with installed system fonts (Helvetica/SF names map to Segoe UI)."
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </shared:SectionHeader.SectionContent>
                        </shared:SectionHeader>
                    </StackPanel>

                    <!-- MULTICAM tab -->
                    <StackPanel x:Name="MulticamTabPane" Spacing="{StaticResource AppTheme.Spacing.Sm}" Visibility="Collapsed">
                        <shared:SectionHeader Title="Multicam group" SectionId="inspector.multicam.group">
                            <shared:SectionHeader.SectionContent>
                                <StackPanel Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                                    <TextBlock
                                        x:Name="MulticamGroupNameLabel"
                                        FontSize="{StaticResource AppTheme.FontSize.Sm}"
                                        Foreground="{StaticResource AppTheme.Text.Primary}"
                                        Text=""
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        x:Name="MulticamCurrentAngleLabel"
                                        FontSize="{StaticResource AppTheme.FontSize.Xs}"
                                        Foreground="{StaticResource AppTheme.Text.Secondary}"
                                        Text=""
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        x:Name="MulticamMembersLabel"
                                        FontSize="{StaticResource AppTheme.FontSize.Xs}"
                                        Foreground="{StaticResource AppTheme.Text.Tertiary}"
                                        Text=""
                                        TextWrapping="WrapWholeWords" />
                                    <shared:EditorRow x:Name="MulticamAngleRow" Label="Switch to">
                                        <shared:EditorRow.RowContent>
                                            <ComboBox
                                                x:Name="MulticamAngleBox"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="MulticamAngle_SelectionChanged" />
                                        </shared:EditorRow.RowContent>
                                    </shared:EditorRow>
                                    <Button
                                        x:Name="MulticamSwitchBtn"
                                        Content="Apply angle"
                                        HorizontalAlignment="Stretch"
                                        Click="MulticamSwitch_Click" />
                                    <TextBlock
                                        FontSize="{StaticResource AppTheme.FontSize.Xs}"
                                        Foreground="{StaticResource AppTheme.Text.Tertiary}"
                                        Text="Creates and ungroups via agent tools (manage_multicam). Multi-angle layouts and overlays are available in preview."
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </shared:SectionHeader.SectionContent>
                        </shared:SectionHeader>
                    </StackPanel>
                </StackPanel>

                <local:AiEditControl x:Name="AiEdit" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

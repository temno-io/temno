<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Temno.App.Controls.InspectorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Temno.App.Controls"
    xmlns:shared="using:Temno.App.Controls.Shared"
    IsTabStop="True" AutomationProperties.Name="Inspector">

    <Grid Background="{StaticResource AppTheme.Background.Surface}">
        <ScrollViewer Padding="{StaticResource AppTheme.Padding.R3Panel}" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RootPanel" Spacing="{StaticResource AppTheme.Spacing.Md}">
                <TextBlock
                    x:Name="EmptyLabel"
                    FontSize="{StaticResource AppTheme.FontSize.Md}"
                    Foreground="{StaticResource AppTheme.Text.Tertiary}"
                    Text=""
                    TextWrapping="WrapWholeWords"
                    Visibility="Collapsed" />

                <StackPanel x:Name="ProjectPanel" Spacing="{StaticResource AppTheme.Spacing.Md}">
                    <shared:SectionHeader Title="Project" SectionId="inspector.project">
                        <shared:SectionHeader.SectionContent>
                            <Grid ColumnSpacing="{StaticResource AppTheme.Spacing.Md}" RowSpacing="{StaticResource AppTheme.Spacing.Sm}">
                                <Grid.ColumnDefinitions>
                                    <!-- DESIGN.md §1 (WP-197): one 96 px label column for Inspector, Captions and Project rows. -->
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Tertiary}" Text="Name" />
                                <TextBlock x:Name="ProjectNameText" Grid.Column="1" FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Secondary}" TextTrimming="CharacterEllipsis" Text="—" />
                                <TextBlock Grid.Row="1" FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Tertiary}" Text="Path" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                                    <Border x:Name="ProjectPathTooltipHost" Background="Transparent">
                                        <TextBlock
                                            x:Name="ProjectPathText"
                                            FontSize="{StaticResource AppTheme.FontSize.Xs}"
                                            Foreground="{StaticResource AppTheme.Text.Tertiary}"
                                            IsTextSelectionEnabled="True"
                                            TextWrapping="Wrap"
                                            Text="—" />
                                    </Border>
                                    <StackPanel x:Name="ProjectPathActions" Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Xs}" Visibility="Collapsed">
                                        <Button
                                            x:Name="CopyProjectPathBtn"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Padding="{StaticResource AppTheme.Padding.XsXxs}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="{StaticResource AppTheme.CornerRadius.XsSm}"
                                            Foreground="{StaticResource AppTheme.Text.Secondary}"
                                            Click="CopyProjectPath_Click"
                                            AutomationProperties.Name="Copy project path"
                                            ToolTipService.ToolTip="Copy full path">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="{StaticResource AppTheme.FontSize.Xs}" Glyph="&#xE8C8;" />
                                                <TextBlock x:Name="CopyProjectPathLabel" FontSize="{StaticResource AppTheme.FontSize.Xs}" Text="Copy" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="RevealProjectPathBtn"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Padding="{StaticResource AppTheme.Padding.XsXxs}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="{StaticResource AppTheme.CornerRadius.XsSm}"
                                            Foreground="{StaticResource AppTheme.Text.Secondary}"
                                            Click="RevealProjectPath_Click"
                                            AutomationProperties.Name="Reveal project in Explorer"
                                            ToolTipService.ToolTip="Reveal in Explorer">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                                                <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xxs}" Height="{StaticResource AppTheme.IconSize.Xxs}" Fill="{x:Bind RevealProjectPathBtn.Foreground, Mode=OneWay}" Icon="{x:Bind shared:Icons.Folder}" />
                                                <TextBlock FontSize="{StaticResource AppTheme.FontSize.Xs}" Text="Reveal" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Row="2" FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Tertiary}" Text="Duration" />
                                <TextBlock x:Name="ProjectDurationText" Grid.Row="2" Grid.Column="1" FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Secondary}" Text="0:00" />
                                <TextBlock Grid.Row="3" FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Tertiary}" Text="Timeline" />
                                <TextBlock x:Name="ProjectTimelineCountText" AutomationProperties.AutomationId="InspectorProjectTimelineCount" Grid.Row="3" Grid.Column="1" FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Secondary}" Text="Empty" />
                            </Grid>
                        </shared:SectionHeader.SectionContent>
                    </shared:SectionHeader>
                    <shared:SectionHeader Title="Settings" SectionId="inspector.settings">
                        <shared:SectionHeader.SectionContent>
                            <Grid ColumnSpacing="{StaticResource AppTheme.Spacing.Md}" RowSpacing="{StaticResource AppTheme.Spacing.Sm}">
                                <Grid.ColumnDefinitions>
                                    <!-- DESIGN.md §1 (WP-197): one 96 px label column (was 88). -->
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Tertiary}" Text="Quality" VerticalAlignment="Center" />
                                <ComboBox x:Name="SettingsQualityBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ProjectSettings_Changed">
                                    <ComboBoxItem Content="720p" Tag="720p" />
                                    <ComboBoxItem Content="1080p" Tag="1080p" IsSelected="True" />
                                    <ComboBoxItem Content="2K" Tag="2K" />
                                    <ComboBoxItem Content="4K" Tag="4K" />
                                    <ComboBoxItem x:Name="SettingsQualityCustomItem" Content="Custom" Tag="custom" Visibility="Collapsed" />
                                </ComboBox>
                                <TextBlock Grid.Row="1" FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Tertiary}" Text="Frame Rate" VerticalAlignment="Center" />
                                <ComboBox x:Name="SettingsFpsBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ProjectSettings_Changed">
                                    <ComboBoxItem Content="24 fps" Tag="24" />
                                    <ComboBoxItem Content="25 fps" Tag="25" />
                                    <ComboBoxItem Content="30 fps" Tag="30" IsSelected="True" />
                                    <ComboBoxItem Content="50 fps" Tag="50" />
                                    <ComboBoxItem Content="60 fps" Tag="60" />
                                    <ComboBoxItem Content="Custom" Tag="custom" />
                                </ComboBox>
                                <TextBlock x:Name="SettingsCustomFpsLabel" Grid.Row="2" FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Tertiary}" Text="Custom FPS" VerticalAlignment="Center" Visibility="Collapsed" />
                                <shared:UnitNumberField
                                    x:Name="SettingsCustomFpsBox"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Visibility="Collapsed"
                                    AutomationProperties.AutomationId="Inspector.CustomFps"
                                    AutomationProperties.Name="Custom project frame rate"
                                    ToolTipService.ToolTip="Custom timeline frame rate (1–120 fps)" />
                                <TextBlock Grid.Row="3" FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Tertiary}" Text="Aspect" VerticalAlignment="Center" />
                                <ComboBox x:Name="SettingsAspectBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ProjectSettings_Changed">
                                    <ComboBoxItem Content="16:9" Tag="16:9" IsSelected="True" />
                                    <ComboBoxItem Content="9:16" Tag="9:16" />
                                    <ComboBoxItem Content="1:1" Tag="1:1" />
                                    <ComboBoxItem Content="4:3" Tag="4:3" />
                                    <ComboBoxItem Content="2.4:1" Tag="2.4:1" />
                                    <ComboBoxItem x:Name="SettingsAspectCustomItem" Content="Custom" Tag="custom" Visibility="Collapsed" />
                                </ComboBox>
                            </Grid>
                        </shared:SectionHeader.SectionContent>
                    </shared:SectionHeader>
                    <TextBlock x:Name="SettingsResolutionText" FontSize="{StaticResource AppTheme.FontSize.Xs}" Foreground="{StaticResource AppTheme.Text.Tertiary}" Text="1920 × 1080 · 30 fps" />

                    <Border
                        x:Name="ProjectAttentionCard"
                        Padding="{StaticResource AppTheme.Padding.Sm}"
                        BorderBrush="{StaticResource AppTheme.Status.Warning}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource AppTheme.CornerRadius.XsSm}"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="ProjectAttentionText"
                            AutomationProperties.AutomationId="InspectorProjectAttention"
                            FontSize="{StaticResource AppTheme.FontSize.Sm}"
                            Foreground="{StaticResource AppTheme.Status.Warning}"
                            TextWrapping="WrapWholeWords" />
                    </Border>
                </StackPanel>

                <StackPanel x:Name="MediaAssetPanel" Spacing="{StaticResource AppTheme.Spacing.Sm}" Visibility="Collapsed">
                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AppTheme.Text.Primary}" Text="Media" />
                    <TextBlock x:Name="MediaAssetName" FontSize="{StaticResource AppTheme.FontSize.Md}" Foreground="{StaticResource AppTheme.Text.Primary}" TextTrimming="CharacterEllipsis" />
                    <Grid ColumnSpacing="{StaticResource AppTheme.Spacing.Md}" RowSpacing="{StaticResource AppTheme.Spacing.Sm}">
                        <Grid.ColumnDefinitions>
                            <!-- DESIGN.md §1 (WP-197): one 96 px label column (was 72). -->
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Tertiary}" Text="Kind" />
                        <TextBlock x:Name="MediaAssetKind" Grid.Column="1" FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Secondary}" />
                        <TextBlock Grid.Row="1" FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Tertiary}" Text="Duration" />
                        <TextBlock x:Name="MediaAssetDuration" Grid.Row="1" Grid.Column="1" FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Secondary}" />
                        <TextBlock Grid.Row="2" FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Tertiary}" Text="Path" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                            <Border x:Name="MediaAssetPathTooltipHost" Background="Transparent">
                                <TextBlock
                                    x:Name="MediaAssetPath"
                                    IsTextSelectionEnabled="True"
                                    FontSize="{StaticResource AppTheme.FontSize.Xs}"
                                    Foreground="{StaticResource AppTheme.Text.Tertiary}"
                                    TextWrapping="Wrap" />
                            </Border>
                            <StackPanel x:Name="MediaAssetPathActions" Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Xs}" Visibility="Collapsed">
                                <Button
                                    x:Name="CopyMediaPathBtn"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="{StaticResource AppTheme.Padding.XsXxs}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource AppTheme.CornerRadius.XsSm}"
                                    Foreground="{StaticResource AppTheme.Text.Secondary}"
                                    Click="CopyMediaPath_Click"
                                    AutomationProperties.Name="Copy media path"
                                    ToolTipService.ToolTip="Copy full path">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="{StaticResource AppTheme.FontSize.Xs}" Glyph="&#xE8C8;" />
                                        <TextBlock x:Name="CopyMediaPathLabel" FontSize="{StaticResource AppTheme.FontSize.Xs}" Text="Copy" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="RevealMediaPathBtn"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="{StaticResource AppTheme.Padding.XsXxs}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource AppTheme.CornerRadius.XsSm}"
                                    Foreground="{StaticResource AppTheme.Text.Secondary}"
                                    Click="RevealMediaPath_Click"
                                    AutomationProperties.Name="Reveal media in Explorer"
                                    ToolTipService.ToolTip="Reveal in Explorer">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                                        <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xxs}" Height="{StaticResource AppTheme.IconSize.Xxs}" Fill="{x:Bind RevealMediaPathBtn.Foreground, Mode=OneWay}" Icon="{x:Bind shared:Icons.Folder}" />
                                        <TextBlock FontSize="{StaticResource AppTheme.FontSize.Xs}" Text="Reveal" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="3" FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Tertiary}" Text="Id" Visibility="Collapsed" />
                        <TextBlock x:Name="MediaAssetId" Visibility="Collapsed" Grid.Row="3" Grid.Column="1" FontSize="{StaticResource AppTheme.FontSize.Xs}" Foreground="{StaticResource AppTheme.Text.Tertiary}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>

                <!-- WP-252: a transition block selected on the timeline. -->
                <StackPanel x:Name="TransitionPanel" Spacing="{StaticResource AppTheme.Spacing.Xxs}" Visibility="Collapsed">
                    <TextBlock
                        x:Name="TransitionTitle"
                        AutomationProperties.AutomationId="InspectorTransitionTitle"
                        FontSize="{StaticResource AppTheme.FontSize.Md}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppTheme.Text.Primary}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="TransitionPlace"
                        AutomationProperties.AutomationId="InspectorTransitionPlace"
                        FontSize="{StaticResource AppTheme.FontSize.Sm}"
                        Foreground="{StaticResource AppTheme.Text.Tertiary}"
                        TextWrapping="WrapWholeWords" />
                    <shared:EditorRow x:Name="TransitionTypeRow" Label="Type">
                        <shared:EditorRow.RowContent>
                            <ComboBox x:Name="TransitionTypeBox" HorizontalAlignment="Stretch" SelectionChanged="TransitionType_SelectionChanged" AutomationProperties.AutomationId="Inspector.TransitionType" AutomationProperties.Name="Transition type" ToolTipService.ToolTip="How the outgoing shot hands over to the incoming one" />
                        </shared:EditorRow.RowContent>
                    </shared:EditorRow>
                    <shared:EditorRow x:Name="TransitionCurveRow" Label="Curve">
                        <shared:EditorRow.RowContent>
                            <ComboBox x:Name="TransitionCurveBox" HorizontalAlignment="Stretch" SelectionChanged="TransitionCurve_SelectionChanged" AutomationProperties.AutomationId="Inspector.TransitionCurve" AutomationProperties.Name="Fade curve" ToolTipService.ToolTip="Linear changes at a steady rate; Smooth eases in and out">
                                <ComboBoxItem Content="Linear" Tag="linear" />
                                <ComboBoxItem Content="Smooth" Tag="smooth" />
                            </ComboBox>
                        </shared:EditorRow.RowContent>
                    </shared:EditorRow>
                    <shared:EditorRow x:Name="TransitionDurationRow" Label="Duration">
                        <shared:EditorRow.RowContent>
                            <shared:UnitNumberField x:Name="TransitionDurationBox" AutomationProperties.AutomationId="Inspector.TransitionDuration" AutomationProperties.Name="Transition duration" ToolTipService.ToolTip="Length in seconds. Drag sideways to scrub, or drag the block's edge on the timeline." />
                        </shared:EditorRow.RowContent>
                    </shared:EditorRow>
                    <TextBlock
                        x:Name="TransitionRoomText"
                        AutomationProperties.AutomationId="InspectorTransitionRoom"
                        FontSize="{StaticResource AppTheme.FontSize.Xs}"
                        Foreground="{StaticResource AppTheme.Text.Tertiary}"
                        TextWrapping="WrapWholeWords" />
                    <Button
                        x:Name="TransitionRemoveButton"
                        Margin="{StaticResource AppTheme.Padding.TopXs}"
                        Click="TransitionRemove_Click"
                        AutomationProperties.AutomationId="Inspector.TransitionRemove"
                        ToolTipService.ToolTip="Remove it from the timeline (Delete)">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Xs}">
                            <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{x:Bind TransitionRemoveButton.Foreground, Mode=OneWay}" Icon="{x:Bind shared:Icons.Delete}" />
                            <TextBlock x:Name="TransitionRemoveText" FontSize="{StaticResource AppTheme.FontSize.Sm}" Text="Remove transition" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="FieldsPanel" Spacing="{StaticResource AppTheme.Spacing.Xxs}" Visibility="Collapsed"
                            XYFocusKeyboardNavigation="Disabled">
                    <TextBlock
                        x:Name="ClipTitle"
                        AutomationProperties.AutomationId="InspectorClipTitle"
                        FontSize="{StaticResource AppTheme.FontSize.Md}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppTheme.Text.Primary}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="ClipTypeLabel"
                        AutomationProperties.AutomationId="InspectorClipType"
                        FontSize="{StaticResource AppTheme.FontSize.Xs}"
                        Foreground="{StaticResource AppTheme.Text.Tertiary}" />
                    <TextBlock
                        x:Name="MultiSelectBanner"
                        AutomationProperties.AutomationId="InspectorMultiSelectBanner"
                        FontSize="{StaticResource AppTheme.FontSize.Xs}"
                        Foreground="{StaticResource AppTheme.Status.Warning}"
                        Text=""
                        TextWrapping="WrapWholeWords"
                        Visibility="Collapsed" />

                    <Border
                        x:Name="TabBarHost"
                        AutomationProperties.AutomationId="InspectorTabBar"
                        Background="{StaticResource AppTheme.Background.Surface}"
                        BorderBrush="{StaticResource AppTheme.Border.Primary}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource AppTheme.CornerRadius.Hairline}"
                        Padding="{StaticResource AppTheme.Padding.Xxs}"
                        Visibility="Collapsed">
                        <StackPanel x:Name="TabBar" Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Xxs}" />
                    </Border>

                    <!-- VIDEO tab -->
                    <StackPanel x:Name="VideoTabPane" Spacing="{StaticResource AppTheme.Spacing.Sm}" Visibility="Collapsed">
                        <shared:SectionHeader Title="Timing" SectionId="inspector.video.timing">
                            <shared:SectionHeader.SectionContent>
                                <StackPanel Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                                    <shared:EditorRow x:Name="StartRow" Label="Start">
                                        <shared:EditorRow.RowContent>
                                            <shared:UnitNumberField x:Name="StartBox" />
                                        </shared:EditorRow.RowContent>
                                    </shared:EditorRow>
                                    <shared:EditorRow x:Name="DurationRow" Label="Duration">
                                        <shared:EditorRow.RowContent>
                                            <shared:UnitNumberField x:Name="DurationBox" />
                                        </shared:EditorRow.RowContent>
                                    </shared:EditorRow>
                                    <TextBlock
                                        x:Name="TimingTimecodeText"
                                        FontFamily="{StaticResource AppTheme.FontFamily.Mono}"
                                        FontSize="{StaticResource AppTheme.FontSize.Xs}"
                                        Foreground="{StaticResource AppTheme.Text.Tertiary}"
                                        Text="" />
                                </StackPanel>
                            </shared:SectionHeader.SectionContent>
                        </shared:SectionHeader>

                        <shared:SectionHeader Title="Transform" SectionId="inspector.video.transform">
                            <shared:SectionHeader.SectionContent>
                                <StackPanel Spacing="{StaticResource AppTheme.Spacing.Xxs}">

                                    <!-- WP-196: one compact line: three small step buttons + inline status. -->

                                    <shared:EditorRow x:Name="ScaleRow" Label="Scale">
                                        <shared:EditorRow.RowContent>
                                            <shared:UnitNumberField x:Name="ScaleBox" AutomationProperties.AutomationId="Inspector.Scale" />
                                        </shared:EditorRow.RowContent>
                                    <shared:EditorRow.RowAccessory><Button x:Name="ScaleKfStampBtn" AllowFocusOnInteraction="False" Width="{StaticResource AppTheme.ComponentSize.KeyframeButtonSize}" MinWidth="0" Height="{StaticResource AppTheme.ComponentSize.KeyframeButtonSize}" MinHeight="0" Background="Transparent" BorderThickness="0" Padding="{StaticResource AppTheme.Padding.Xxs}" Click="ScaleKfStamp_Click" AutomationProperties.Name="Stamp scale keyframe at playhead" ToolTipService.ToolTip="Stamp / remove scale keyframe at playhead" ><shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{x:Bind ScaleKfStampBtn.Foreground, Mode=OneWay}" Icon="{x:Bind shared:Icons.Diamond}" /></Button></shared:EditorRow.RowAccessory>
                                    </shared:EditorRow>

                                    <shared:EditorRow x:Name="PosXRow" Label="Center X">
                                        <shared:EditorRow.RowContent>
                                            <shared:UnitNumberField x:Name="PosXBox" />
                                        </shared:EditorRow.RowContent>
                                    <shared:EditorRow.RowAccessory><Button x:Name="PositionKfStampBtn" AllowFocusOnInteraction="False" Width="{StaticResource AppTheme.ComponentSize.KeyframeButtonSize}" MinWidth="0" Height="{StaticResource AppTheme.ComponentSize.KeyframeButtonSize}" MinHeight="0" Background="Transparent" BorderThickness="0" Padding="{StaticResource AppTheme.Padding.Xxs}" Click="PositionKfStamp_Click" AutomationProperties.Name="Stamp position keyframe at playhead" ToolTipService.ToolTip="Stamp / remove position keyframe at playhead" ><shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{x:Bind PositionKfStampBtn.Foreground, Mode=OneWay}" Icon="{x:Bind shared:Icons.Diamond}" /></Button></shared:EditorRow.RowAccessory>
                                    </shared:EditorRow>
                                    <shared:EditorRow x:Name="PosYRow" Label="Center Y">
                                        <shared:EditorRow.RowContent>
                                            <shared:UnitNumberField x:Name="PosYBox" />
                                        </shared:EditorRow.RowContent>
                                    </shared:EditorRow>

                                    <shared:EditorRow x:Name="RotationRow" Label="Rotation">
                                        <shared:EditorRow.RowContent>
                                            <shared:UnitNumberField x:Name="RotBox" />
                                        </shared:EditorRow.RowContent>
                                    <shared:EditorRow.RowAccessory><Button x:Name="RotationKfStampBtn" AllowFocusOnInteraction="False" Width="{StaticResource AppTheme.ComponentSize.KeyframeButtonSize}" MinWidth="0" Height="{StaticResource AppTheme.ComponentSize.KeyframeButtonSize}" MinHeight="0" Background="Transparent" BorderThickness="0" Padding="{StaticResource AppTheme.Padding.Xxs}" Click="RotationKfStamp_Click" AutomationProperties.Name="Stamp rotation keyframe at playhead" ToolTipService.ToolTip="Stamp / remove rotation keyframe at playhead" ><shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{x:Bind RotationKfStampBtn.Foreground, Mode=OneWay}" Icon="{x:Bind shared:Icons.Diamond}" /></Button></shared:EditorRow.RowAccessory>
                                    </shared:EditorRow>
<shared:EditorRow x:Name="OpacityRow" Label="Opacity">
                                        <shared:EditorRow.RowContent>
                                            <shared:UnitNumberField x:Name="OpacityBox" AutomationProperties.AutomationId="Inspector.Opacity" />
                                        </shared:EditorRow.RowContent>
                                    <shared:EditorRow.RowAccessory><Button x:Name="OpacityKfStampBtn" AllowFocusOnInteraction="False" Width="{StaticResource AppTheme.ComponentSize.KeyframeButtonSize}" MinWidth="0" Height="{StaticResource AppTheme.ComponentSize.KeyframeButtonSize}" MinHeight="0" Background="Transparent" BorderThickness="0" Padding="{StaticResource AppTheme.Padding.Xxs}" Click="OpacityKfStamp_Click" AutomationProperties.Name="Stamp opacity keyframe at playhead" ToolTipService.ToolTip="Stamp / remove opacity keyframe at playhead" ><shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{x:Bind OpacityKfStampBtn.Foreground, Mode=OneWay}" Icon="{x:Bind shared:Icons.Diamond}" /></Button></shared:EditorRow.RowAccessory>
                                    </shared:EditorRow>
                                    <shared:EditorRow x:Name="VideoFadeInRow" Label="Fade in">
                                        <shared:EditorRow.RowContent>
                                            <shared:UnitNumberField x:Name="VideoFadeInBox" AutomationProperties.AutomationId="Inspector.VideoFadeIn" AutomationProperties.Name="Fade in" ToolTipService.ToolTip="Picture fade in, in seconds. Edits this clip, not its linked audio." />
                                        </shared:EditorRow.RowContent>
                                    </shared:EditorRow>
                                    <shared:EditorRow x:Name="VideoFadeOutRow" Label="Fade out">
                                        <shared:EditorRow.RowContent>
                                            <shared:UnitNumberField x:Name="VideoFadeOutBox" AutomationProperties.AutomationId="Inspector.VideoFadeOut" AutomationProperties.Name="Fade out" ToolTipService.ToolTip="Picture fade out, in seconds. Edits this clip, not its linked audio." />
                                        </shared:EditorRow.RowContent>
                                    </shared:EditorRow>


                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Sm}">
                                        <ToggleButton x:Name="FlipHBtn" Content="Flip H" Click="Flip_Click" />
                                        <ToggleButton x:Name="FlipVBtn" Content="Flip V" Click="Flip_Click" />
                                    </StackPanel>
                                    <shared:EditorRow x:Name="BlendModeRow" Label="Blend mode">
                                        <shared:EditorRow.RowContent>
                                            <ComboBox x:Name="BlendModeBox" HorizontalAlignment="Stretch" PlaceholderText="—" SelectionChanged="BlendMode_SelectionChanged" AutomationProperties.AutomationId="Inspector.BlendMode" AutomationProperties.Name="Blend mode">
                                                <ComboBoxItem Content="Normal" Tag="normal" />
                                                <ComboBoxItem Content="Multiply" Tag="multiply" />
                                                <ComboBoxItem Content="Screen" Tag="screen" />
                                                <ComboBoxItem Content="Overlay" Tag="overlay" />
                                                <ComboBoxItem Content="Darken" Tag="darken" />
                                                <ComboBoxItem Content="Lighten" Tag="lighten" />
                                                <ComboBoxItem Content="Add" Tag="add" />
                                            </ComboBox>
                                        </shared:EditorRow.RowContent>
                                    </shared:EditorRow>
                                </StackPanel>
                            </shared:SectionHeader.SectionContent>
                        </shared:SectionHeader>


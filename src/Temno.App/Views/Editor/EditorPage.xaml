                        BorderBrush="{StaticResource AppTheme.Border.Subtle}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource AppTheme.CornerRadius.None}"
                        Tag="Preview">
                        <controls:PreviewHostControl
                            x:Name="Preview"
                            PlayheadChanged="Preview_PlayheadChanged"
                            ProjectSettingsChanged="Inspector_ProjectSettingsChanged" />
                    </Border>

                    <controls:GridResizeThumb
                        x:Name="InspectorSplitter"
                        Grid.Column="3"
                        MinSize="150"
                        MaxSize="480"
                        Invert="True"
                        Orientation="Vertical" />

                    <!-- INSPECTOR -->
                    <Border
                        x:Name="InspectorPanel"
                        Grid.Column="4"
                        shared:Motion.Fade="{StaticResource AppTheme.Anim.Transition}"
                        Margin="{StaticResource AppTheme.Padding.None}"
                        Background="{StaticResource AppTheme.Background.Surface}"
                        BorderBrush="{StaticResource AppTheme.Border.Subtle}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource AppTheme.CornerRadius.None}"
                        Tag="Inspector">
                        <controls:InspectorControl
                            x:Name="Inspector"
                            ClipEdited="Inspector_ClipEdited"
                            ClipPreviewing="Inspector_ClipPreviewing"
                            MediaLibraryChanged="Inspector_MediaLibraryChanged"
                            ProjectSettingsChanged="Inspector_ProjectSettingsChanged"
                            SeekPlayheadRequested="Inspector_SeekPlayheadRequested" />
                    </Border>
            <!-- AGENT -->
            <Border
                x:Name="AgentPanel"
                Grid.Column="4"
                Margin="{StaticResource AppTheme.Padding.None}"
                Background="{StaticResource AppTheme.Background.Surface}"
                BorderBrush="{StaticResource AppTheme.Border.Subtle}"
                shared:Motion.Fade="{StaticResource AppTheme.Anim.Transition}"
                BorderThickness="0"
                CornerRadius="{StaticResource AppTheme.CornerRadius.None}"
                Tag="Agent">
                <controls:AgentPanelControl
                    x:Name="Agent"
                    OpenSettingsRequested="Agent_OpenSettingsRequested"
                    OpenAccountRequested="Agent_OpenAccountRequested"
                    CloseRequested="Agent_CloseRequested"
                    ToolsMutated="Agent_ToolsMutated" />
            </Border>

            <controls:GridResizeThumb
                x:Name="AgentSplitter"
                Grid.Column="3"
                MinSize="240"
                MaxSize="640"
                Invert="True" Orientation="Vertical" />

                </Grid>

                <controls:GridResizeThumb
                    x:Name="TimelineSplitter"
                    Grid.Row="1"
                    MinSize="100"
                    MaxSize="700"
                    Invert="True"
                    Orientation="Horizontal" />

                <!-- TIMELINE — Mac stack: tabs (28) → toolbar (38) → lanes | meter -->
                <Border
                    x:Name="TimelinePanel"
                    Grid.Row="2"
                    Margin="{StaticResource AppTheme.Padding.None}"
                    Background="{StaticResource AppTheme.Background.Surface}"
                    BorderBrush="{StaticResource AppTheme.Border.Subtle}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource AppTheme.CornerRadius.None}"
                    Tag="Timeline">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource AppTheme.Grid.HeaderHeight}" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="TimelineToolbar" SizeChanged="TimelineToolbar_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="TimelineTabsColumn" Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="TimelineTabsHost"
                            Background="{StaticResource AppTheme.Background.Raised}"
                            BorderBrush="{StaticResource AppTheme.Border.Primary}"
                            BorderThickness="0,0,0,1"
                            Padding="{StaticResource AppTheme.Padding.HSmMd}">
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="{StaticResource AppTheme.Spacing.Xs}">
                                <ScrollViewer
                                    x:Name="TimelineTabsScroll"
                                    HorizontalScrollMode="Enabled"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Disabled"
                                    PointerWheelChanged="TimelineTabsScroll_PointerWheelChanged">
                                    <ItemsControl x:Name="TimelineTabsList" SizeChanged="TimelineTabsList_SizeChanged">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Xxs}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TimelineTabItem">
                                                <Border
                                                    Background="{x:Bind ActiveBackground}"
                                                    CornerRadius="{StaticResource AppTheme.CornerRadius.XsSm}"
                                                    Opacity="{x:Bind ActiveOpacity}"
                                                    RightTapped="TimelineTab_RightTapped"
                                                    Tag="{x:Bind Id}">
                                                    <Grid>
                                                        <StackPanel
                                                            Padding="{StaticResource AppTheme.Padding.SmXxsRightXs}"
                                                            Orientation="Horizontal"
                                                            Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                                                            <Button
                                                                MinWidth="0"
                                                                MinHeight="0"
                                                                Padding="{StaticResource AppTheme.Padding.HXs}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="TimelineTab_Click"
                                                                DoubleTapped="TimelineTab_DoubleTapped"
                                                                Tag="{x:Bind Id}"
                                                                ToolTipService.ToolTip="{x:Bind TabToolTip}">
                                                                <TextBlock
                                                                    MaxWidth="156"
                                                                    FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                                                                    FontWeight="{x:Bind ActiveWeight}"
                                                                    Foreground="{x:Bind ActiveForeground}"
                                                                    Text="{x:Bind Name}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </Button>
                                                            <Button
                                                                Width="18"
                                                                Height="18"
                                                                MinWidth="0"
                                                                MinHeight="0"
                                                                Padding="{StaticResource AppTheme.Padding.None}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="TimelineTabClose_Click"
                                                                Foreground="{StaticResource AppTheme.Text.Tertiary}"
                                                                Tag="{x:Bind Id}"
                                                                AutomationProperties.Name="{x:Bind CloseAutomationName}"
                                                                ToolTipService.ToolTip="Close tab"
                                                                Visibility="{x:Bind CloseVisibility}">
                                                                <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Text.Tertiary}" Icon="{x:Bind shared:Icons.Dismiss}" />
                                                            </Button>
                                                        </StackPanel>
                                                        <Border
                                                            Height="2"
                                                            VerticalAlignment="Bottom"
                                                            Background="{StaticResource AppTheme.Accent.Brand}"
                                                            CornerRadius="{StaticResource AppTheme.CornerRadius.Hairline}"
                                                            IsHitTestVisible="False"
                                                            Visibility="{x:Bind ActiveIndicatorVisibility}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button
                                    x:Name="AddTimelineButton"
                                    MinWidth="28"
                                    Padding="{StaticResource AppTheme.Padding.SmXxs}"
                                    Click="AddTimeline_Click"
                                    AutomationProperties.Name="Add timeline"
                                    ToolTipService.ToolTip="Add timeline">
                                    <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Text.Primary}" Icon="{x:Bind shared:Icons.Add}" />
                                </Button>
                                <Button
                                    x:Name="TimelineAllTabsButton"
                                    MinWidth="28"
                                    Padding="{StaticResource AppTheme.Padding.SmXxs}"
                                    Click="TimelineAllTabs_Click"
                                    AutomationProperties.Name="All timelines"
                                    ToolTipService.ToolTip="All timelines"
                                    Visibility="Collapsed">
                                    <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Text.Secondary}" Icon="{x:Bind shared:Icons.ChevronDown}" />
                                </Button>
                                <Border
                                    Width="1"
                                    Height="16"
                                    Margin="{StaticResource AppTheme.Padding.HXs}"
                                    Background="{StaticResource AppTheme.Border.Subtle}" />
                            </StackPanel>
                        </Border>                        <Border
                            Grid.Column="1"
                            Background="{StaticResource AppTheme.Background.Raised}"
                            BorderBrush="{StaticResource AppTheme.Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="{StaticResource AppTheme.Padding.HSmMd}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                                    <Button
                                        MinWidth="{StaticResource AppTheme.ComponentSize.ChromeButtonWidth}"
                                        Padding="{StaticResource AppTheme.Padding.SmXs}"
                                        Click="MenuUndo_Click"
                                        AutomationProperties.Name="Undo"
                                        ToolTipService.ToolTip="Undo (Ctrl+Z)">
                                        <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Text.Primary}" Icon="{x:Bind shared:Icons.ArrowUndo}" />
                                    </Button>
                                    <Button
                                        MinWidth="{StaticResource AppTheme.ComponentSize.ChromeButtonWidth}"
                                        Padding="{StaticResource AppTheme.Padding.SmXs}"
                                        Click="MenuRedo_Click"
                                        AutomationProperties.Name="Redo"
                                        ToolTipService.ToolTip="Redo (Ctrl+Y)">
                                        <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Text.Primary}" Icon="{x:Bind shared:Icons.ArrowRedo}" />
                                    </Button>
                                    <Border
                                        Width="1"
                                        Height="16"
                                        Margin="{StaticResource AppTheme.Padding.HXs}"
                                        Background="{StaticResource AppTheme.Border.Subtle}" />
                                    <ToggleButton
                                        x:Name="ToolSelect"
                                        MinWidth="{StaticResource AppTheme.ComponentSize.ChromeButtonWidth}"
                                        Padding="{StaticResource AppTheme.Padding.SmXs}"
                                        Click="ToolSelect_Click"
                                        IsChecked="True"
                                        AutomationProperties.Name="Select tool"
                                        ToolTipService.ToolTip="Select tool (V)">
                                        <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Text.Primary}" Icon="{x:Bind shared:Icons.Cursor}" />
                                    </ToggleButton>
                                    <ToggleButton
                                        x:Name="ToolTrim"
                                        MinWidth="{StaticResource AppTheme.ComponentSize.ChromeButtonWidth}"
                                        Padding="{StaticResource AppTheme.Padding.SmXs}"
                                        Click="ToolTrim_Click"
                                        AutomationProperties.Name="Trim tool"
                                        ToolTipService.ToolTip="Trim tool (2)">
                                        <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Text.Primary}" Icon="{x:Bind shared:Icons.ArrowBidirectionalLeftRight}" />
                                    </ToggleButton>
                                    <ToggleButton
                                        x:Name="ToolBlade"
                                        MinWidth="{StaticResource AppTheme.ComponentSize.ChromeButtonWidth}"
                                        Padding="{StaticResource AppTheme.Padding.SmXs}"
                                        Click="ToolBlade_Click"
                                        AutomationProperties.Name="Blade tool"
                                        ToolTipService.ToolTip="Blade tool (C or 3)">
                                        <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Text.Primary}" Icon="{x:Bind shared:Icons.Cut}" />
                                    </ToggleButton>
                                    <Button
                                        MinWidth="{StaticResource AppTheme.ComponentSize.ChromeButtonWidth}"
                                        Padding="{StaticResource AppTheme.Padding.SmXs}"
                                        Click="MenuSplit_Click"
                                        AutomationProperties.Name="Split at playhead"
                                        ToolTipService.ToolTip="Split at playhead (B)">
                                        <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Text.Primary}" Icon="{x:Bind shared:Icons.SplitVertical}" />
                                    </Button>
                                    <Border x:Name="TimelineModesDivider"
                                        Width="1"
                                        Height="16"
                                        Margin="{StaticResource AppTheme.Padding.HXs}"
                                        Background="{StaticResource AppTheme.Border.Subtle}" />
                                    <ToggleButton
                                        x:Name="ToolRipple"
                                        MinWidth="64"
                                        Padding="{StaticResource AppTheme.Padding.SmXs}"
                                        Click="ToolRipple_Click"
                                        Content="Ripple"
                                        FontSize="{StaticResource AppTheme.FontSize.Sm}"
                                        IsChecked="True"
                                        AutomationProperties.Name="Ripple delete"
                                        ToolTipService.ToolTip="Ripple: drop inserts (pushes later clips); delete closes gaps" />
                                    <ToggleButton
                                        x:Name="ToolOverwrite"
                                        MinWidth="64"
                                        Padding="{StaticResource AppTheme.Padding.SmXs}"
                                        Click="ToolOverwrite_Click"
                                        Content="Overwrite"
                                        FontSize="{StaticResource AppTheme.FontSize.Sm}"
                                        AutomationProperties.Name="Overwrite on move"
                                        ToolTipService.ToolTip="Overwrite on move" />
                                    <ToggleButton
                                        x:Name="ToolSnap"
                                        MinWidth="64"
                                        Padding="{StaticResource AppTheme.Padding.SmXs}"
                                        Click="ToolSnap_Click"
                                        Content="Snap"
                                        FontSize="{StaticResource AppTheme.FontSize.Sm}"
                                        IsChecked="True"
                                        AutomationProperties.Name="Snap"
                                        ToolTipService.ToolTip="Snap to clips and playhead" />
                                    <Button
                                        MinWidth="64"
                                        Padding="{StaticResource AppTheme.Padding.SmXs}"
                                        x:Name="ToolFit" Click="ToolFit_Click"
                                        Content="Fit"
                                        FontSize="{StaticResource AppTheme.FontSize.Sm}"
                                        AutomationProperties.Name="Fit timeline"
                                        ToolTipService.ToolTip="Fit timeline to window" />
                                    <Border x:Name="TimelineTextDivider"
                                        Width="1"
                                        Height="16"
                                        Margin="{StaticResource AppTheme.Padding.HXs}"
                                        Background="{StaticResource AppTheme.Border.Subtle}" />
                                    <Button
                                        MinWidth="{StaticResource AppTheme.ComponentSize.ChromeButtonWidth}"
                                        Padding="{StaticResource AppTheme.Padding.SmXs}"
                                        x:Name="ToolAddText" Click="AddText_Click"
                                        AutomationProperties.Name="Add text"
                                        ToolTipService.ToolTip="Add text at playhead">
                                        <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Text.Primary}" Icon="{x:Bind shared:Icons.Text}" />
                                    </Button>
                                    <Button x:Name="ToolOverflowButton" Click="ToolOverflow_Click" Visibility="Collapsed"
                                            MinWidth="{StaticResource AppTheme.ComponentSize.ChromeButtonWidth}"
                                            AutomationProperties.Name="More timeline tools" ToolTipService.ToolTip="More timeline tools"
                                            Padding="{StaticResource AppTheme.Padding.SmXs}">
                                        <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}"
                                                           Icon="{x:Bind shared:Icons.MoreHorizontal}" Fill="{StaticResource AppTheme.Text.Primary}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel
                                    x:Name="TimelineZoomCluster"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource AppTheme.Spacing.Sm}">
                                    <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Text.Muted}" Icon="{x:Bind shared:Icons.Search}" />
                                    <Slider
                                        x:Name="TimelineZoomSlider"
                                        Width="100"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Timeline zoom"
                                        ToolTipService.ToolTip="Timeline zoom — the readout shows how much time fits in view"
                                        ValueChanged="TimelineZoomSlider_ValueChanged" />
                                    <TextBlock
                                        x:Name="TimelineZoomValue"
                                        MinWidth="{StaticResource AppTheme.ComponentSize.AgentButtonWidth}"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource AppTheme.FontSize.Xs}"
                                        Foreground="{StaticResource AppTheme.Text.Tertiary}"
                                        Text="" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        </Grid>
                        <!-- Row 3: tracks | full-height meter (Mac AudioMeterView 32px) -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource AppTheme.Grid.ChromeButtonWidth}" />
                            </Grid.ColumnDefinitions>
                            <controls:TimelineControl
                                x:Name="Timeline"
                                PlayheadChanged="Timeline_PlayheadChanged"
                                ScrubStarted="Timeline_ScrubStarted"
                                ScrubEnded="Timeline_ScrubEnded"
                                SelectionChanged="Timeline_SelectionChanged"
                                TimelineEdited="Timeline_TimelineEdited"
                                ContextActionRequested="Timeline_ContextActionRequested"
                                ZoomChanged="Timeline_ZoomChanged"
                                EmptyImportRequested="Timeline_EmptyImportRequested" />
                            <Border
                                Grid.Column="1"
                                Background="{StaticResource AppTheme.Background.Base}"
                                BorderBrush="{StaticResource AppTheme.Border.Subtle}"
                                BorderThickness="1,0,0,0"
                                ToolTipService.ToolTip="Audio levels (source peaks at playhead)">
                                <Grid Padding="{StaticResource AppTheme.Padding.XsSmMd}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Margin="{StaticResource AppTheme.Padding.HHairline}"
                                        Background="{StaticResource AppTheme.Background.Raised}"
                                        CornerRadius="{StaticResource AppTheme.CornerRadius.Hairline}">
                                        <Rectangle
                                            x:Name="MeterLeft"
                                            Height="0"
                                            VerticalAlignment="Bottom"
                                            Fill="{StaticResource AppTheme.Status.Success}" />
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Margin="{StaticResource AppTheme.Padding.HHairline}"
                                        Background="{StaticResource AppTheme.Background.Raised}"
                                        CornerRadius="{StaticResource AppTheme.CornerRadius.Hairline}">
                                        <Rectangle
                                            x:Name="MeterRight"
                                            Height="0"
                                            VerticalAlignment="Bottom"
                                            Fill="{StaticResource AppTheme.Status.Success}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
                </Grid>

                <controls:GridResizeThumb
                    x:Name="SidePreviewSplitter"
                    Grid.Column="1"
                    MinSize="200"
                    MaxSize="2000"
                    Invert="True"
                    Orientation="Vertical"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- Compact status (Mac has none; keep single-line for Windows diagnostics) -->
        <Border
            Grid.Row="2"
            Padding="{StaticResource AppTheme.Padding.MdXxs}"
            Background="{StaticResource AppTheme.Background.Base}"
            BorderBrush="{StaticResource AppTheme.Border.Subtle}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    x:Name="StatusText"
                    FontSize="{StaticResource AppTheme.FontSize.Xs}"
                    Foreground="{StaticResource AppTheme.Text.Tertiary}"
                    Text="" />
                <TextBlock
                    x:Name="PathText"
                    HorizontalAlignment="Right"
                    FontSize="{StaticResource AppTheme.FontSize.Xs}"
                    Foreground="{StaticResource AppTheme.Text.Tertiary}"
                    Opacity="0.7"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Page>

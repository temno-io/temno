<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Temno.App.Views.Editor.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Temno.App.Controls"
    xmlns:shared="using:Temno.App.Controls.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Temno.App.ViewModels"
    Background="{StaticResource AppTheme.Background.Base}"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Padding="{StaticResource AppTheme.Padding.None}"
        AllowFocusOnInteraction="True"
        IsTabStop="True"
        SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
          Mac TitleBar (Windows-inverted): this strip IS the window title bar (SetTitleBar).
          Left: menus + agent bubble · Center: project name only · Right: Export + caption inset.
          No "Temno Windows" brand strip — Mac uses system title for project name only.
        -->
        <Grid
            x:Name="EditorTitleBar"
            Height="{StaticResource AppTheme.ComponentSize.HeaderHeight}"
            Background="{StaticResource AppTheme.Background.Surface}"
            BorderBrush="{StaticResource AppTheme.Border.Subtle}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <!-- Space under Windows min / max / close -->
                <ColumnDefinition Width="{StaticResource AppTheme.Grid.CaptionButtonsWidth}" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Margin="{StaticResource AppTheme.Padding.LeftSmMd}"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{StaticResource AppTheme.Spacing.Xs}">
                <Button Click="Close_Click" AutomationProperties.Name="Home" ToolTipService.ToolTip="Home — projects"
                        Width="{StaticResource AppTheme.ComponentSize.ChromeButtonWidth}" Background="Transparent" BorderThickness="0" Padding="{StaticResource AppTheme.Padding.None}">
                    <Image Width="{StaticResource AppTheme.IconSize.Standard}" Height="{StaticResource AppTheme.IconSize.Standard}" Source="ms-appx:///Assets/icons/home.svg" />
                </Button>
                <ToggleButton x:Name="MenuDisclosureButton" Click="MenuDisclosure_Click" IsChecked="False"
                              Width="{StaticResource AppTheme.ComponentSize.KeyframeButtonSize}" MinWidth="0" Background="Transparent" BorderThickness="0"
                              Padding="{StaticResource AppTheme.Padding.None}" AutomationProperties.Name="Show application menus"
                              ToolTipService.ToolTip="Application menus (Alt or F10)">
                    <shared:FluentIcon x:Name="MenuChevron" Width="{StaticResource AppTheme.IconSize.Xxs}" Height="{StaticResource AppTheme.IconSize.Xxs}" Icon="{x:Bind shared:Icons.ChevronRight}"
                                       Fill="{StaticResource AppTheme.Text.Secondary}" RenderTransformOrigin="0.5,0.5">
                        <shared:FluentIcon.RenderTransform><CompositeTransform x:Name="MenuChevronTransform" /></shared:FluentIcon.RenderTransform>
                    </shared:FluentIcon>
                </ToggleButton>
                <Grid x:Name="MenuRevealHost" Width="{StaticResource AppTheme.BorderWidth.Thin}" SizeChanged="MenuRevealHost_SizeChanged">
                    <Grid.Clip><RectangleGeometry x:Name="MenuRevealClip" /></Grid.Clip>
                <MenuBar
                    x:Name="EditorMenuBar" Padding="{StaticResource AppTheme.Padding.None}"
                    Width="{StaticResource AppTheme.ComponentSize.MenuRevealWidth}"
                    HorizontalAlignment="Left" Opacity="0" IsHitTestVisible="False"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Application menu">
                    <MenuBar.RenderTransform><CompositeTransform x:Name="MenuRevealTransform" TranslateX="-8" /></MenuBar.RenderTransform>
                    <MenuBarItem Width="{StaticResource AppTheme.ComponentSize.MenuItemWidth}" Margin="{StaticResource AppTheme.Padding.None}" Title="File" AccessKey="F">
                        <MenuFlyoutItem Click="MenuNewProject_Click" Text="New Project…" KeyboardAcceleratorTextOverride="Ctrl+N" />
                        <MenuFlyoutItem Click="MenuNewFolder_Click" Text="New Folder…" />
                        <MenuFlyoutItem Click="MenuOpenProject_Click" Text="Open Project…" KeyboardAcceleratorTextOverride="Ctrl+O" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="Save_Click" Text="Save" KeyboardAcceleratorTextOverride="Ctrl+S" />
                        <MenuFlyoutItem Click="SaveAs_Click" Text="Save As…" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="ImportMedia_Click" Text="Import Media…" KeyboardAcceleratorTextOverride="Ctrl+I" />
                        <MenuFlyoutItem Click="Export_Click" Text="Export…" KeyboardAcceleratorTextOverride="Ctrl+M" />
                        <MenuFlyoutItem Click="MenuShareStub_Click" Text="Share…" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="Reveal_Click" Text="Reveal Project in Explorer" />
                        <MenuFlyoutItem Click="Close_Click" Text="Close Project" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="MenuSettings_Click" Text="Settings…" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="MenuQuit_Click" Text="Exit" />
                    </MenuBarItem>
                    <MenuBarItem Width="{StaticResource AppTheme.ComponentSize.MenuItemWidth}" Margin="{StaticResource AppTheme.Padding.None}" Title="Edit" AccessKey="E">
                        <MenuFlyoutItem Click="MenuUndo_Click" Text="Undo" KeyboardAcceleratorTextOverride="Ctrl+Z" />
                        <MenuFlyoutItem Click="MenuRedo_Click" Text="Redo" KeyboardAcceleratorTextOverride="Ctrl+Y" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="MenuSelectForwardTrack_Click" Text="Select Forward on Track" KeyboardAcceleratorTextOverride="A" />
                        <MenuFlyoutItem Click="MenuSelectForwardAll_Click" Text="Select Forward on All Tracks" KeyboardAcceleratorTextOverride="Shift+A" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="MenuSplit_Click" Text="Split at Playhead" KeyboardAcceleratorTextOverride="B" />
                        <MenuFlyoutItem Click="MenuAddMarker_Click" Text="Add Marker" KeyboardAcceleratorTextOverride="M" />
                        <MenuFlyoutItem Click="MenuTrimStart_Click" Text="Trim Start to Playhead" KeyboardAcceleratorTextOverride="Q" />
                        <MenuFlyoutItem Click="MenuTrimEnd_Click" Text="Trim End to Playhead" KeyboardAcceleratorTextOverride="W" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="MenuDelete_Click" Text="Delete" KeyboardAcceleratorTextOverride="Delete" />
                        <MenuFlyoutItem Click="MenuRippleDelete_Click" Text="Ripple Delete" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="MenuLink_Click" Text="Link Selection" KeyboardAcceleratorTextOverride="Ctrl+L" />
                        <MenuFlyoutItem Click="MenuUnlink_Click" Text="Unlink Selection" KeyboardAcceleratorTextOverride="Ctrl+Shift+L" />
                        <MenuFlyoutItem Click="MenuRestoreLinkedAudio_Click" Text="Restore Linked Audio" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="MenuAddVideoTrack_Click" Text="Add Video Track" />
                        <MenuFlyoutItem Click="MenuAddAudioTrack_Click" Text="Add Audio Track" />
                        <MenuFlyoutSeparator />
                        <RadioMenuFlyoutItem
                            x:Name="MenuToolSelectItem"
                            Click="MenuToolSelect_Click"
                            GroupName="EditorToolMode"
                            KeyboardAcceleratorTextOverride="V"
                            Text="Select" />
                        <RadioMenuFlyoutItem
                            x:Name="MenuToolTrimItem"
                            Click="MenuToolTrim_Click"
                            GroupName="EditorToolMode"
                            KeyboardAcceleratorTextOverride="2"
                            Text="Trim" />
                        <RadioMenuFlyoutItem
                            x:Name="MenuToolBladeItem"
                            Click="MenuToolBlade_Click"
                            GroupName="EditorToolMode"
                            KeyboardAcceleratorTextOverride="C"
                            Text="Blade" />
                    </MenuBarItem>
                    <MenuBarItem Width="{StaticResource AppTheme.ComponentSize.MenuItemWidth}" Margin="{StaticResource AppTheme.Padding.None}" Title="View" AccessKey="V">
                        <ToggleMenuFlyoutItem x:Name="MenuItemMediaPanel" Click="MenuToggleMedia_Click" Text="Media Panel" />
                        <ToggleMenuFlyoutItem x:Name="MenuItemInspectorPanel" Click="MenuToggleInspector_Click" Text="Inspector" />
                        <ToggleMenuFlyoutItem x:Name="MenuItemAgentPanel" Click="MenuToggleAgent_Click" Text="Agent" />
                        <MenuFlyoutItem Click="MenuShowHiddenPanels_Click" Text="Show Hidden Panels" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="MenuMaximize_Click" Text="Maximize Focused Panel" KeyboardAcceleratorTextOverride="`" />
                        <MenuFlyoutItem Click="MenuRestoreLayout_Click" Text="Restore Layout" KeyboardAcceleratorTextOverride="Esc" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="MenuLayoutDefault_Click" Text="Layout: Default" />
                        <MenuFlyoutItem Click="MenuLayoutMedia_Click" Text="Layout: Media" />
                        <MenuFlyoutItem Click="MenuLayoutVertical_Click" Text="Layout: Vertical" />
                        <MenuFlyoutItem Click="MenuLayoutPreview_Click" Text="Layout: Preview" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="MenuFullScreen_Click" Text="Enter Full Screen" />
                    </MenuBarItem>
                    <MenuBarItem Width="{StaticResource AppTheme.ComponentSize.MenuItemWidth}" Margin="{StaticResource AppTheme.Padding.None}" Title="Help" AccessKey="H">
                        <MenuFlyoutItem Click="MenuTutorial_Click" Text="Tutorial" />
                        <MenuFlyoutItem Click="MenuShortcuts_Click" Text="Keyboard Shortcuts" />
                        <MenuFlyoutItem Click="MenuMcpInstructions_Click" Text="MCP Instructions" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="MenuCheckUpdates_Click" Text="Check for Updates…" />
                        <MenuFlyoutItem Click="MenuAbout_Click" Text="About Temno" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="MenuFeedback_Click" Text="Send Feedback…" />
                    </MenuBarItem>
                </MenuBar>
                </Grid>

                <!-- Hidden state holders for panel visibility -->
                <ToggleButton
                    x:Name="ToggleMedia"
                    IsTabStop="False"
                    Width="0"
                    Height="0"
                    Padding="{StaticResource AppTheme.Padding.None}"
                    Opacity="0"
                    IsHitTestVisible="False"
                    IsChecked="True"
                    Click="ToggleMedia_Click" />
                <ToggleButton
                    x:Name="ToggleInspector"
                    IsTabStop="False"
                    Width="0"
                    Height="0"
                    Padding="{StaticResource AppTheme.Padding.None}"
                    Opacity="0"
                    IsHitTestVisible="False"
                    IsChecked="True"
                    Click="ToggleInspector_Click" />
            </StackPanel>

            <Border x:Name="EditorDragRegion" Grid.Column="1" Background="Transparent" />
            <TextBlock
                x:Name="ProjectTitleText"
                Grid.Column="1"
                Margin="{StaticResource AppTheme.Padding.LeftLgXl}"
                IsHitTestVisible="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="{StaticResource AppTheme.FontSize.Md}"
                FontWeight="SemiBold"
                Foreground="{StaticResource AppTheme.Text.Primary}"
                Text="Project"
                TextTrimming="CharacterEllipsis" />
            <!-- Kept for code that updates timeline summary into status -->
            <TextBlock x:Name="TimelineSummaryText" Visibility="Collapsed" />

            <!-- Mac TitleBarTrailingView: Update chip, then Export, left of captions. -->
            <StackPanel
                Grid.Column="2"
                Margin="{StaticResource AppTheme.Padding.RightXs}"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                <!-- Mac TitleBarLeadingView: agent bubble -->
                <ToggleButton
                    x:Name="ToggleAgent"
                    Width="{StaticResource AppTheme.ComponentSize.AgentButtonWidth}"
                    Height="{StaticResource AppTheme.ComponentSize.CompactButtonHeight}"
                    Padding="{StaticResource AppTheme.Padding.None}"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.Name="Toggle agent panel"
                    Click="ToggleAgent_Click"
                    IsChecked="False"
                    ToolTipService.ToolTip="Toggle agent panel">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Xs}"><shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" x:Name="ToggleAgentIcon" Fill="{StaticResource AppTheme.Text.Secondary}" Icon="{x:Bind shared:Icons.Sparkle}" /><TextBlock Text="Agent" FontSize="{StaticResource AppTheme.FontSize.Md}" /></StackPanel>
                </ToggleButton>
                <Button
                    x:Name="TitleBarUpdateButton"
                    Height="{StaticResource AppTheme.IconSize.Lg}"
                    MinWidth="0"
                    Padding="{StaticResource AppTheme.Padding.HSmMd}"
                    Margin="{StaticResource AppTheme.Padding.RightXs}"
                    Background="{StaticResource AppTheme.Update.ChipFill}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource AppTheme.CornerRadius.Capsule}"
                    AutomationProperties.Name="Install update"
                    Click="TitleBarUpdate_Click"
                    ToolTipService.ToolTip="A newer build is available"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Sm}">
                        <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Accent.Timecode}" Icon="{x:Bind shared:Icons.ArrowDownload}" />
                        <TextBlock
                            x:Name="TitleBarUpdateLabel"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource AppTheme.FontSize.Sm}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AppTheme.Accent.Timecode}"
                            Text="Update" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ExportQueueButton"
                    Padding="{StaticResource AppTheme.Padding.Control}"
                    Style="{StaticResource AccentButtonStyle}"
                    BorderThickness="1"
                    AutomationProperties.Name="Export"
                    Click="ExportQueueButton_Click"
                    ToolTipService.ToolTip="Export queue (idle)">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.SmMd}">
                        <Border
                            x:Name="ExportQueueDot"
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center"
                            Background="{StaticResource AppTheme.Text.Muted}"
                            CornerRadius="{StaticResource AppTheme.CornerRadius.XsSm}" />
                        <TextBlock
                            x:Name="ExportQueueLabel"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                            Foreground="{StaticResource AppTheme.Text.Secondary}"
                            Text="Export" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="AccountButton"
                    Width="28"
                    Height="{StaticResource AppTheme.ComponentSize.CompactButtonHeight}"
                    Padding="{StaticResource AppTheme.Padding.None}"
                    AutomationProperties.Name="Account"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="MenuAccount_Click"
                    ToolTipService.ToolTip="Account">
                    <shared:AccountAvatar x:Name="HeaderAccountAvatar" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Default Mac topology: Agent | (Media | Preview | Inspector) / Timeline -->
        <Grid x:Name="ShellGrid" Grid.Row="1" Margin="{StaticResource AppTheme.Padding.TopXxs}">
            <!-- WORKSPACE: MainStack | optional side Preview (Vertical preset) -->
            <Grid x:Name="WorkspaceGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MainStackCol" Width="*" MinWidth="200" />
                    <ColumnDefinition x:Name="SidePreviewSplitterCol" Width="0" />
                    <ColumnDefinition x:Name="SidePreviewCol" Width="0" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="MainStack" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="UpperRow" Height="*" MinHeight="80" />
                    <RowDefinition x:Name="TimelineSplitterRow" Height="5" />
                    <RowDefinition
                        x:Name="TimelineRow"
                        Height="220"
                        MinHeight="0"
                        MaxHeight="700" />
                </Grid.RowDefinitions>

                <!-- Upper: Media | Preview | Inspector -->
                <Grid x:Name="UpperGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            x:Name="MediaCol"
                            Width="{StaticResource AppTheme.Grid.DefaultPanelWidth}"
                            MinWidth="0" />
                        <ColumnDefinition x:Name="MediaSplitterCol" Width="5" />
                        <ColumnDefinition
                            x:Name="PreviewCol"
                            Width="*"
                            MinWidth="0" />
                        <ColumnDefinition x:Name="InspectorSplitterCol" Width="5" />
                        <ColumnDefinition
                            x:Name="InspectorCol"
                            Width="{StaticResource AppTheme.Grid.DefaultPanelWidth}"
                            MinWidth="0" />
                    </Grid.ColumnDefinitions>

                    <!-- MEDIA (WP-73/WP-131: Mac MediaPanelView rail + Media / Index / Captions / Audio) -->
                    <Border
                        x:Name="MediaPanel"
                        Margin="{StaticResource AppTheme.Padding.None}"
                        AllowDrop="True"
                        shared:Motion.Fade="{StaticResource AppTheme.Anim.Transition}"
                        Background="{StaticResource AppTheme.Background.Surface}"
                        BorderBrush="{StaticResource AppTheme.Border.Subtle}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource AppTheme.CornerRadius.None}"
                        DragOver="MediaPanel_DragOver"
                        Drop="MediaPanel_Drop"
                        Tag="Media">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{StaticResource AppTheme.Grid.SourceTabsHeight}" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Background="{StaticResource AppTheme.Background.Surface}"
                                  BorderBrush="{StaticResource AppTheme.Border.Primary}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="RailMediaBtn" Grid.Column="0" HorizontalAlignment="Stretch"
                                              Height="{StaticResource AppTheme.ComponentSize.CompactButtonHeight}" MinHeight="0" Margin="{StaticResource AppTheme.Padding.Xs}"
                                              Padding="{StaticResource AppTheme.Padding.None}" IsChecked="True"
                                              Tag="Media" Click="MediaRail_Click" AutomationProperties.Name="Media"
                                              ToolTipService.ToolTip="Media" BorderThickness="0">
                                    <Grid>
                                        <Border x:Name="RailMediaIndicator" Visibility="Visible" Height="{StaticResource AppTheme.BorderWidth.Thick}"
                                                VerticalAlignment="Bottom" Background="{StaticResource AppTheme.Accent.Brand}" />
                                        <TextBlock Text="Media" FontSize="{StaticResource AppTheme.FontSize.Md}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>
                                </ToggleButton>
                                <ToggleButton x:Name="RailIndexBtn" Grid.Column="1" HorizontalAlignment="Stretch"
                                              Height="{StaticResource AppTheme.ComponentSize.CompactButtonHeight}" MinHeight="0" Margin="{StaticResource AppTheme.Padding.Xs}"
                                              Padding="{StaticResource AppTheme.Padding.None}" IsChecked="False"
                                              Tag="Index" Click="MediaRail_Click" AutomationProperties.Name="Index"
                                              ToolTipService.ToolTip="Index" BorderThickness="0">
                                    <Grid>
                                        <Border x:Name="RailIndexIndicator" Visibility="Collapsed" Height="{StaticResource AppTheme.BorderWidth.Thick}"
                                                VerticalAlignment="Bottom" Background="{StaticResource AppTheme.Accent.Brand}" />
                                        <TextBlock Text="Index" FontSize="{StaticResource AppTheme.FontSize.Md}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>
                                </ToggleButton>
                                <ToggleButton x:Name="RailCaptionsBtn" Grid.Column="2" HorizontalAlignment="Stretch"
                                              Height="{StaticResource AppTheme.ComponentSize.CompactButtonHeight}" MinHeight="0" Margin="{StaticResource AppTheme.Padding.Xs}"
                                              Padding="{StaticResource AppTheme.Padding.None}" IsChecked="False"
                                              Tag="Captions" Click="MediaRail_Click" AutomationProperties.Name="Captions"
                                              ToolTipService.ToolTip="Captions" BorderThickness="0">
                                    <Grid>
                                        <Border x:Name="RailCaptionsIndicator" Visibility="Collapsed" Height="{StaticResource AppTheme.BorderWidth.Thick}"
                                                VerticalAlignment="Bottom" Background="{StaticResource AppTheme.Accent.Brand}" />
                                        <TextBlock Text="Captions" FontSize="{StaticResource AppTheme.FontSize.Md}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>
                                </ToggleButton>
                                <ToggleButton x:Name="RailAudioBtn" Grid.Column="3" HorizontalAlignment="Stretch"
                                              Height="{StaticResource AppTheme.ComponentSize.CompactButtonHeight}" MinHeight="0" Margin="{StaticResource AppTheme.Padding.Xs}"
                                              Padding="{StaticResource AppTheme.Padding.None}" IsChecked="False"
                                              Tag="Audio" Click="MediaRail_Click" AutomationProperties.Name="Audio"
                                              ToolTipService.ToolTip="Audio" BorderThickness="0">
                                    <Grid>
                                        <Border x:Name="RailAudioIndicator" Visibility="Collapsed" Height="{StaticResource AppTheme.BorderWidth.Thick}"
                                                VerticalAlignment="Bottom" Background="{StaticResource AppTheme.Accent.Brand}" />
                                        <TextBlock Text="Audio" FontSize="{StaticResource AppTheme.FontSize.Md}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>
                                </ToggleButton>
                            </Grid>

                            <!-- MEDIA TAB -->
                            <Grid
                                x:Name="MediaTabPane"
                                Grid.Row="1"
                                shared:Motion.Fade="{StaticResource AppTheme.Anim.Transition}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Mac MediaTab: Import row + search + Library context -->
                            <Border Grid.Row="1"
                                Height="{StaticResource Layout.PanelHeaderHeight}"
                                Background="{StaticResource AppTheme.Background.Raised}"
                                BorderBrush="{StaticResource AppTheme.Border.Primary}"
                                BorderThickness="0,0,0,1"
                                Padding="{StaticResource AppTheme.Padding.HSmMd}">
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource AppTheme.Spacing.Sm}">
                                    <Button
                                        Padding="{StaticResource AppTheme.Padding.MdXxs}"
                                        Click="ImportMedia_Click"
                                        FontSize="{StaticResource AppTheme.FontSize.Sm}"
                                        ToolTipService.ToolTip="Import video, image, or audio files">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                                            <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Text.Primary}" Icon="{x:Bind shared:Icons.Add}" />
                                            <TextBlock Text="Import" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Padding="{StaticResource AppTheme.Padding.SmXs}"
                                        Click="LinkMedia_Click"
                                        FontSize="{StaticResource AppTheme.FontSize.Sm}"
                                        AutomationProperties.Name="Link media in place"
                                        ToolTipService.ToolTip="Add media without copying it into the project. Faster and smaller, but the project is no longer self-contained: if the original moves, the asset goes offline.">
                                        <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Text.Primary}" Icon="{x:Bind shared:Icons.Link}" />
                                    </Button>
                                    <Button
                                        Padding="{StaticResource AppTheme.Padding.SmXs}"
                                        Click="NewFolder_Click"
                                        FontSize="{StaticResource AppTheme.FontSize.Sm}"
                                        AutomationProperties.Name="New folder"
                                        ToolTipService.ToolTip="Create a folder in the current media location">
                                        <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Text.Primary}" Icon="{x:Bind shared:Icons.FolderAdd}" />
                                    </Button>
                                    <Button
                                        Padding="{StaticResource AppTheme.Padding.SmXs}"
                                        Click="CreateMatte_Click"
                                        FontSize="{StaticResource AppTheme.FontSize.Sm}"
                                        AutomationProperties.Name="Create matte"
                                        ToolTipService.ToolTip="Create a solid-color PNG matte in the current folder">
                                        <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Xs}" Height="{StaticResource AppTheme.IconSize.Xs}" Fill="{StaticResource AppTheme.Text.Primary}" Icon="{x:Bind shared:Icons.RectangleLandscapeFilled}" />
                                    </Button>
                                    <Button
                                        Padding="{StaticResource AppTheme.Padding.SmXs}"
                                        Background="{StaticResource AppTheme.Background.Prominent}"
                                        BorderBrush="{StaticResource AppTheme.Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource AppTheme.CornerRadius.XsSm}"
                                        FontSize="{StaticResource AppTheme.FontSize.Sm}"
                                        Click="MediaGenerate_Click"
                                        AutomationProperties.Name="Generate media"
                                        ToolTipService.ToolTip="Open the generation panel">
                                        <TextBlock Text="Generate" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <StackPanel
                                Grid.Row="0"
                                Padding="{StaticResource AppTheme.Padding.ChipDense}"
                                Spacing="{StaticResource AppTheme.Spacing.Xs}">

                                <!-- WP-399: files this project names outside its folder stay blocked until allowed -->
                                <InfoBar
                                    x:Name="ExternalMediaBar"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Files outside this project"
                                    Closed="ExternalMediaBar_Closed"
                                    IsClosable="True"
                                    IsOpen="False"
                                    Severity="Warning"
                                    Title="Files outside this project">
                                    <InfoBar.ActionButton>
                                        <Button
                                            x:Name="ExternalMediaReviewBtn"
                                            AutomationProperties.Name="Review files outside this project"
                                            Click="ExternalMediaReview_Click"
                                            Content="Review…"
                                            ToolTipService.ToolTip="See which files this project names outside its folder, and allow them" />
                                    </InfoBar.ActionButton>
                                </InfoBar>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="MediaBreadcrumbBar" Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.Xs}" />
                                    </ScrollViewer>
                                    <TextBlock
                                        x:Name="MediaSearchStatus"
                                        Grid.Column="1"
                                        Margin="{StaticResource AppTheme.Padding.LeftSmMd}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource AppTheme.FontSize.Xs}"
                                        Foreground="{StaticResource AppTheme.Text.Tertiary}"
                                        Text="0 items"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        x:Name="MediaViewOptionsBtn"
                                        Grid.Column="2"
                                        Margin="{StaticResource AppTheme.Padding.LeftSmMd}"
                                        Padding="{StaticResource AppTheme.Padding.SmXxs}"
                                        AutomationProperties.Name="Media view options"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTipService.ToolTip="View mode and thumbnail size">

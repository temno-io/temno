<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Temno.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Temno.App.Controls.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Temno.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Temno.App.ViewModels"
    Background="{StaticResource AppTheme.Background.Base}"
    mc:Ignorable="d">

    <Grid AllowDrop="True" DragOver="HomeRoot_DragOver" Drop="HomeRoot_DropAsync" SizeChanged="HomeRoot_SizeChanged">
        <Grid x:Name="HomeContent" Padding="{StaticResource AppTheme.Padding.R3Page}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- WP-186: one row owns creation and opening. The empty state below shows the same
                 New Project button and hides this one, so there is one primary action on screen.
                 WP-203: search + sort sit under that row; the GridView is row 3, the empty states row 3 too. -->
            <Grid
                Grid.Row="0"
                Margin="{StaticResource AppTheme.Padding.TopSmMdBottomLgXl}"
                ColumnSpacing="{StaticResource AppTheme.Spacing.Sm}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="ProjectsHeading"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource AppTheme.FontSize.Xl}"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource AppTheme.Text.Secondary}"
                    Text="Projects" />
                <Button
                    x:Name="OpenProjectButton"
                    Grid.Column="1"
                    AutomationProperties.Name="Open Project"
                    Click="OpenProject_Click"
                    Content="Open Project…"
                    ToolTipService.ToolTip="Open a .temno or .palmier package from disk" />
                <Button
                    x:Name="NewProjectButton"
                    Grid.Column="2"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="New Project"
                    Click="NewProject_Click"
                    Content="New Project"
                    ToolTipService.ToolTip="Create a project — name, optional canvas preset and frame rate" />
            </Grid>

            <!-- WP-203: search + sort. Hidden while the empty state shows (nothing to search). -->
            <Grid
                x:Name="SearchSortRow"
                Grid.Row="1"
                Margin="{StaticResource AppTheme.Padding.TopSmMdBottomLgXl}"
                ColumnSpacing="{StaticResource AppTheme.Spacing.Sm}"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    Width="{StaticResource AppTheme.ComponentSize.ProjectSearchWidth}"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Search projects"
                    PlaceholderText="Search projects"
                    TextChanged="SearchBox_TextChanged"
                    ToolTipService.ToolTip="Filter by project name or folder" />
                <ComboBox
                    x:Name="SortBox"
                    Grid.Column="1"
                    MinWidth="150"
                    AutomationProperties.Name="Sort projects"
                    SelectionChanged="SortBox_SelectionChanged"
                    ToolTipService.ToolTip="Sort the project list">
                    <ComboBoxItem Content="Last opened" IsSelected="True" Tag="opened" />
                    <ComboBoxItem Content="Name" Tag="name" />
                    <ComboBoxItem Content="Duration" Tag="duration" />
                </ComboBox>
            </Grid>

            <Grid Grid.Row="2">
                <GridView
                    x:Name="ProjectsGrid"
                    IsItemClickEnabled="True"
                    ItemClick="ProjectsGrid_ItemClick"
                    SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectItemViewModel">
                            <Border
                                Width="{StaticResource AppTheme.ComponentSize.ProjectCardWidth}"
                                Height="{StaticResource AppTheme.ComponentSize.ProjectCardHeight}"
                                Margin="{StaticResource AppTheme.Padding.SmMd}"
                                Background="{StaticResource AppTheme.Background.Raised}"
                                BorderBrush="{StaticResource AppTheme.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource AppTheme.CornerRadius.Sm}"
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                Opacity="{x:Bind CardOpacity}"
                                ToolTipService.ToolTip="{x:Bind Path}">
                                <Border.ContextFlyout>
                                    <MenuFlyout ShouldConstrainToRootBounds="True" shared:WindowPopout.ConstrainContextMenu="True">
                                        <MenuFlyoutItem Click="OpenMenu_Click" Text="Open" Tag="{x:Bind}" />
                                        <MenuFlyoutItem Click="RevealMenu_Click" Text="Reveal in Explorer" Tag="{x:Bind}" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Click="RemoveMenu_Click" Text="Remove from list" Tag="{x:Bind}" />
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Background="{StaticResource AppTheme.Background.Prominent}">
                                        <Grid>
                                            <!-- WP-186: a deliberate poster fallback — glyph and a line, not an empty slab. -->
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="{StaticResource AppTheme.Spacing.Xs}"
                                                Visibility="{x:Bind FallbackVisibility}">
                                                <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.LgXl}" Height="{StaticResource AppTheme.IconSize.LgXl}" HorizontalAlignment="Center" Fill="{StaticResource AppTheme.Text.Tertiary}" Icon="{x:Bind shared:Icons.Document}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                                                    Foreground="{StaticResource AppTheme.Text.Tertiary}"
                                                    Text="{x:Bind FallbackLabel}" />
                                            </StackPanel>
                                            <Image
                                                Source="{x:Bind Thumbnail}"
                                                Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <StackPanel
                                        Grid.Row="1"
                                        Padding="{StaticResource AppTheme.Padding.R3Panel}"
                                        Background="{StaticResource AppTheme.Background.Surface}"
                                        Spacing="{StaticResource AppTheme.Spacing.Xxs}">
                                        <TextBlock
                                            FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                                            Foreground="{StaticResource AppTheme.Text.Primary}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                                            Foreground="{StaticResource AppTheme.Text.Tertiary}"
                                            Text="{x:Bind MetadataLabel}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                                            Foreground="{StaticResource AppTheme.Text.Tertiary}"
                                            Text="{x:Bind LastOpenedLabel}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- Empty state (WP-186): one centred group. The header's New Project hides while this shows. -->
                <StackPanel
                    x:Name="EmptyState"
                    MaxWidth="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource AppTheme.Spacing.MdLg}"
                    Visibility="Collapsed">
                    <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Hero}" Height="{StaticResource AppTheme.IconSize.Hero}" HorizontalAlignment="Center" Fill="{StaticResource AppTheme.Text.Tertiary}" Icon="{x:Bind shared:Icons.Document}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="{StaticResource AppTheme.FontSize.Lg}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppTheme.Text.Primary}"
                        Text="Start your first project" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                        Foreground="{StaticResource AppTheme.Text.Tertiary}"
                        Text="Import footage, build a timeline, and shape the cut. Your projects stay on this PC."
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <Button
                        x:Name="EmptyNewButton"
                        HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="New Project"
                        Click="EmptyNew_Click"
                        Content="New Project"
                        ToolTipService.ToolTip="Create a project — name, optional canvas preset and frame rate" />
                </StackPanel>

                <!-- WP-203: search matched nothing. Distinct from EmptyState (which owns creation);
                     this one owns clearing the search. -->
                <StackPanel
                    x:Name="NoResultsState"
                    MaxWidth="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource AppTheme.Spacing.MdLg}"
                    Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="{StaticResource AppTheme.FontSize.Lg}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppTheme.Text.Primary}"
                        Text="No matching projects" />
                    <TextBlock
                        x:Name="NoResultsBody"
                        HorizontalAlignment="Center"
                        FontSize="{StaticResource AppTheme.FontSize.SmMd}"
                        Foreground="{StaticResource AppTheme.Text.Tertiary}"
                        Text="Nothing in your project list matches this search."
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <Button
                        x:Name="ClearSearchButton"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Clear search"
                        Click="ClearSearch_Click"
                        Content="Clear search"
                        ToolTipService.ToolTip="Show every project again" />
                </StackPanel>
            </Grid>
            <Button x:Name="UpdateSidebarCard" Grid.Row="3" HorizontalAlignment="Left"
                    Visibility="Collapsed" Click="UpdateSidebar_Click"
                    PointerEntered="UpdateSidebar_PointerEntered" PointerExited="UpdateSidebar_PointerExited"
                    AutomationProperties.Name="Click to install update" Margin="{StaticResource AppTheme.Padding.TopSmMd}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppTheme.Spacing.SmMd}">
                    <shared:FluentIcon Width="{StaticResource AppTheme.IconSize.Sm}" Height="{StaticResource AppTheme.IconSize.Sm}" Icon="{x:Bind shared:Icons.ArrowDownload}" />
                    <TextBlock x:Name="UpdateSidebarVersion" Text="Update available" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Row="4" Text="Projects stay on this PC" Margin="{StaticResource AppTheme.Padding.TopSmMd}"
                       FontSize="{StaticResource AppTheme.FontSize.Sm}" Foreground="{StaticResource AppTheme.Text.Tertiary}" />
        </Grid>
        <InfoBar x:Name="StatusBar" VerticalAlignment="Bottom" IsClosable="True" IsOpen="False" Severity="Error" />
    </Grid>
</Page>

    <!-- WP-134: every ToggleButton paints its checked state in the app amber
         (AppTheme.Accent.Timecode) — not the Windows system accent. This is the
         fix described in WP-134 §3. The WP names it as an implicit
         Style TargetType="ToggleButton" whose Resources override the checked
         brushes. WinUI's Style type has no Resources member, so the equivalent
         lightweight-styling form is used: dictionary-level theme overrides with
         the same keys. They are resolved via the same resource lookup for
         every ToggleButton — XAML (EditorPage, TimelineControl,
         InspectorControl) and the 5 trait buttons built in code by
         EditorPage.Captions.cs (TraitButton) — so no per-site call and no
         SharedControlTheme overload are needed. Without this, WP-128's Style
         traits (B/I/L/C/R) render pink beside an amber ToggleSwitch/toggle
         in the same panel. An empty implicit Style is kept so the WP's
         "Style TargetType" description remains literally present. -->
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource AppTheme.Accent.SelectedColor}" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource AppTheme.Accent.SelectedColor}" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource AppTheme.Accent.SelectedColor}" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{StaticResource AppTheme.Accent.BrandColor}" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{StaticResource AppTheme.Accent.BrandColor}" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{StaticResource AppTheme.Accent.BrandColor}" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{StaticResource AppTheme.Accent.ReadableColor}" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{StaticResource AppTheme.Accent.ReadableColor}" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{StaticResource AppTheme.Accent.ReadableColor}" />
    <!-- WP-180: one accent system. Every stock accent-bearing control the app uses reads its colour
         from these dictionary-level keys instead of the Windows system accent, which is whatever the
         user picked in Settings and is not a token. Amber (Accent.Timecode) is app state and
         selection; cream (Accent.Primary) is the primary action, which is what a ContentDialog's
         default button becomes through AccentButtonStyle; on-state glyphs sit on Background.Base.
         These are plain keys in a dictionary merged after XamlControlsResources, so every
         {ThemeResource} lookup in the control templates finds them first — the same mechanism
         WP-134 proved for ToggleButton. SharedControlTheme.ApplyAccent, which repainted ToggleSwitch
         per site, is gone: this block is the single source. -->
    <Color x:Key="SystemAccentColor">#FF6366F1</Color>
    <Color x:Key="SystemAccentColorLight1">#FF8183F4</Color>
    <Color x:Key="SystemAccentColorLight2">#FFB5B7FF</Color>
    <Color x:Key="SystemAccentColorLight3">#FFDADAFE</Color>
    <Color x:Key="SystemAccentColorDark1">#FF4F52D1</Color>
    <Color x:Key="SystemAccentColorDark2">#FF3D3FA7</Color>
    <Color x:Key="SystemAccentColorDark3">#FF2E307E</Color>
